{
  "sections": {
    "hero": {
      "type": "custom-liquid",
      "settings": {
        "liquid": "\n<style>\n.cxh{--bone:#F5F1ED;--bone2:#EDE7E0;--char:#1C1C1C;--blush:#E7C4C7;--blushd:#C98B90;--sale:#B14A45;\n  font-family:inherit;color:var(--char);-webkit-font-smoothing:antialiased}\n.cxh *{box-sizing:border-box} .cxh img{display:block;max-width:100%} .cxh a{text-decoration:none;color:inherit}\n\n/* announcement */\n.cxh-announce{background:var(--char);color:var(--bone);text-align:center;font-size:.8rem;\n  font-weight:600;letter-spacing:.04em;padding:.6rem 1rem}\n.cxh-announce b{color:var(--blush)}\n\n/* HERO */\n.cxh-hero{position:relative;background:linear-gradient(120deg,var(--bone2) 0%,var(--blush) 120%);overflow:hidden}\n.cxh-hero .in{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;\n  align-items:center;gap:20px;min-height:560px;padding:0 24px}\n.cxh-hero .photo{position:relative;height:100%;min-height:560px}\n.cxh-hero .photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 15%}\n.cxh-hero .offer{padding:48px 0}\n.cxh-hero .kick{font-weight:800;letter-spacing:.16em;text-transform:uppercase;font-size:.8rem}\n.cxh-hero .lc{display:inline-block;background:var(--sale);color:#fff;font-weight:800;font-size:.72rem;\n  letter-spacing:.1em;text-transform:uppercase;padding:.28rem .6rem;border-radius:3px;margin:10px 0}\n.cxh-hero .big{display:flex;align-items:baseline;gap:.5rem;line-height:.85;margin:.1rem 0 .3rem}\n.cxh-hero .big .u{font-weight:800;font-size:1.5rem}\n.cxh-hero .big .n{font-weight:900;font-size:clamp(4rem,11vw,7rem);letter-spacing:-.04em}\n.cxh-hero .big .o{font-weight:800;font-size:2rem}\n.cxh-hero .desc{max-width:32ch;font-size:1.02rem;opacity:.82;margin:.6rem 0 1.4rem;font-weight:500}\n.cxh-hero .cta{display:inline-flex;align-items:center;justify-content:center;background:var(--char);\n  color:var(--bone);font-weight:800;font-size:1rem;letter-spacing:.02em;padding:1.1rem 2.6rem;border-radius:6px;\n  min-height:56px;box-shadow:0 6px 20px rgba(28,28,28,.18);transition:.15s}\n.cxh-hero .cta:hover{transform:translateY(-1px);box-shadow:0 10px 26px rgba(28,28,28,.24)}\n.cxh-hero .microtrust{display:flex;gap:18px;flex-wrap:wrap;margin-top:18px;font-size:.82rem;font-weight:600;opacity:.8}\n.cxh-hero .microtrust span{display:flex;align-items:center;gap:6px}\n.cxh-hero .microtrust .star{color:var(--blushd)}\n@media(max-width:820px){\n  .cxh-hero .in{grid-template-columns:1fr;min-height:auto;padding:0}\n  .cxh-hero .photo{order:-1;min-height:62vw}\n  .cxh-hero .offer{padding:28px 24px 34px;text-align:center}\n  .cxh-hero .desc{margin-left:auto;margin-right:auto}\n  .cxh-hero .cta{width:100%}\n  .cxh-hero .microtrust{justify-content:center}\n}\n\n/* trust bar under hero */\n.cxh-tb{background:var(--char);color:var(--bone)}\n.cxh-tb .in{max-width:1240px;margin:0 auto;display:flex;justify-content:center;gap:36px;flex-wrap:wrap;\n  padding:.85rem 24px;font-size:.82rem;font-weight:600;letter-spacing:.02em}\n.cxh-tb .in span{display:flex;align-items:center;gap:8px}\n.cxh-tb .in b{color:var(--blush)}\n@media(max-width:600px){.cxh-tb .in{gap:14px 24px;font-size:.76rem}}\n\n/* ===== Shapermint badge treatment on REAL theme product cards ===== */\n.shopify-section .product-card__badge-list,.product-card__badge-list{top:10px!important;left:10px!important;gap:6px!important}\n.product-card__badge-list .badge,.product-card .badge{\n  border-radius:3px!important;font-weight:800!important;font-size:.62rem!important;letter-spacing:.06em!important;\n  text-transform:uppercase!important;padding:.32rem .5rem!important;line-height:1!important}\n/* strikethrough compare-at emphasis + bold sale price */\n.product-card .price s,.product-card__info s{color:var(--taupe,#A69E95)!important;font-weight:500!important}\n.product-card .price--on-sale,.product-card__info .price{font-weight:800!important}\n</style>\n\n<div class=\"cxh\">\n  <div class=\"cxh-announce\"><b>FREE SHIPPING OVER $80</b> &nbsp;·&nbsp; FREE EXCHANGES UNTIL IT FITS</div>\n\n  <section class=\"cxh-hero\">\n    <div class=\"in\">\n      <div class=\"offer\">\n        <div class=\"kick\">Summer sale</div>\n        <div class=\"lc\">Last chance</div>\n        <div class=\"big\"><span class=\"u\">Up to</span><span class=\"n\">50</span><span class=\"o\">% off</span></div>\n        <p class=\"desc\">The no-gap jeans curvy women reorder in every wash. Selling fast, and your size won't wait.</p>\n        <a class=\"cta\" href=\"/collections/all-products\">Shop the sale &nbsp;&rarr;</a>\n        <div class=\"microtrust\">\n          <span><span class=\"star\">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 4.8 · 20,000+ reviews</span>\n          <span>&#10003; No-gap guarantee</span>\n        </div>\n      </div>\n      <div class=\"photo\">\n        <img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=1200\" alt=\"Women wearing CURVS no-gap jeans\" loading=\"eager\">\n      </div>\n    </div>\n  </section>\n\n  <div class=\"cxh-tb\">\n    <div class=\"in\">\n      <span><b>&#9733;</b> 4.8/5 from 20,000+</span>\n      <span>&#10227; Free exchanges</span>\n      <span>&#8635; 14-day returns</span>\n      <span>&#128666; Free shipping over $80</span>\n    </div>\n  </div>\n</div>\n",
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
