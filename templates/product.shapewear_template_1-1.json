 gap: 8px;\n  }\n\n  .usp-atc-item {\n    padding: 6px 8px;\n    min-height: 60px;\n  }\n\n  .usp-atc-item p {\n    font-size: 11px;\n  }\n\n  .usp-atc-icon {\n    width: 22px;\n    height: 22px;\n  }\n}\n<\/style>"}},"liquid_6YeDGA":{"type":"liquid","disabled":true,"settings":{"liquid":"<div class=\"payment-icons-container\">\n  <ul class=\"payment-icons-list\">\n    <li class=\"payment-icon-item\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/klarna.svg?v=1731852955\" alt=\"Klarna Payment\" class=\"payment-icon\" \/>\n    <\/li>\n    <!-- Static Icons -->\n    <li class=\"payment-icon-item\">\n      <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/ideal.svg?v=1731852955\" alt=\"iDEAL Payment\" class=\"payment-icon\" \/>\n    <\/li>\n    <!-- Dynamic Payment Icons (Show a limited number) -->\n    {%- for type in shop.enabled_payment_types limit: 5 -%}\n      {%- unless type == 'ideal' or type == 'klarna' or type == 'bancontact' -%}\n      <li class=\"payment-icon-item\">\n        {{ type | payment_type_svg_tag: class: 'payment-icon' }}\n      <\/li>\n      {%- endunless -%}\n    {%- endfor -%}\n  <\/ul>\n<\/div>\n\n<style>\n\/* Container for payment icons *\/\n.payment-icons-container {\n  margin: 10px auto; \/* Center the container *\/\n margin-top: 10px !important;\nmargin-bottom: 10px auto; !important;\n  padding: 5px 0;\n  max-width: 100%;\n  display: flex;\n  justify-content: center;\n}\n\n\/* Style for the list of payment icons *\/\n.payment-icons-list {\n  display: flex;\n  justify-content: center;\n  gap: 15px; \/* Equal space between each icon *\/\n  padding: 0;\n  margin: 0;\n  list-style: none; \/* Remove default list styling *\/\n}\n\n\/* Style for each icon item *\/\n.payment-icon-item {\n  display: flex;\n  align-items: center;\n}\n\n\/* Style for the payment icons *\/\n.payment-icon {\n  width: 40px; \/* Icon width *\/\n  height: auto; \/* Maintain aspect ratio *\/\n}\n\n\/* Mobile-specific adjustments *\/\n@media (max-width: 768px) {\n  .payment-icon {\n    width: 30px; \/* Smaller size for mobile *\/\n  }\n\n  .payment-icons-list {\n    gap: 10px; \/* Reduce gap for mobile screens *\/\n  }\n}\n<\/style>"}},"kiwi_size_chart_recommender_kiwi_sizing_zVwWrC":{"type":"shopify:\/\/apps\/kiwi-size-chart-recommender\/blocks\/kiwiSizing\/b7369922-bf15-44ce-a121-a22a8fcbc4b0","settings":{"waitForElementSelector":"","waitForElementDelay":5}},"collapsible_text_xrHaci":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Compression Level","content":"","page":""}},"collapsible_text_7KYfLw":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Description","content":"{{ product.description }}","page":""}},"collapsible_text_rcQ8QH":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Size & Confidence Guarantee","content":"<p>Not sure which size will sculpt your shape? Take our <strong>15-second Fit Quiz<\/strong> right under the size picker for instant guidance.<\/p><ul><li>Shapewear always looks small when you unpack it — that’s normal. It’s built to stretch, sculpt, and hug your curves.<\/li><li>Order your usual size for a snatched, sculpted effect. Prefer a little more comfort for all-day wear? Size up.<br\/><br\/>And don’t stress: if it doesn’t make you feel confident, our <strong>Confidence Guarantee<\/strong> means you can exchange it free until it does. <\/li><\/ul>","page":""}},"collapsible_text_XtCTEg":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Shipping & Returns","content":"<p>Delivered to you in 4-6 working days, track & trace code included. Free shipping above €80. <br\/><br\/>We offer a 14 day return or exchange policy, no questions asked! Simply start your own return <a href=\"https:\/\/curvjeans.returnless.com\/nl\" target=\"_blank\" title=\"https:\/\/curvjeans.returnless.com\/\">here.<\/a><\/p>","page":""}},"collapsible_text_HUDbb7":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"FAQ","content":"<p><strong>How do I know which size to pick?<\/strong><br\/>Shapewear sizing can feel tricky, we get it. Just use our 15-second Fit Quiz or check the Size Guide — we list real measurements, so you’ll know exactly what works for your shape. Still unsure? <strong>Exchanges are free<\/strong> until you find the perfect fit.<\/p><p><strong>Will it roll down?<\/strong><br\/>No. Our Seamless Snatched bodysuit is designed with a grip band and compression that actually stays in place. No awkward tugging, no rolling. Just smooth support that moves with you.<br\/><br\/><strong>Can I wear it all day?<\/strong><br\/>Yes! We made sure the fabric is breathable and soft so you can feel sculpted without feeling suffocated. Snatched enough for a night out, comfy enough for a full day.<\/p><p><strong>How do I go to the bathroom in it?<\/strong><br\/>We thought of that. The snap closure at the gusset makes bathroom breaks quick and easy. No need to take everything off.<br\/><br\/><strong>Will it show under clothes?<\/strong><br\/>Nope. The seamless design disappears under dresses, jeans, or even tight tops. It’s your invisible confidence booster.<\/p>","page":""}},"liquid_papGaB":{"type":"liquid","disabled":true,"settings":{"liquid":"<!-- Back to Top Button -->\n<a href=\"#top\" class=\"back-to-top\" id=\"backToTop\" aria-label=\"Back to top\">\n  <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/arrow-up-svgrepo-com.svg?v=1743044799\" alt=\"Back to top\">\n<\/a>\n\n<style>\n.back-to-top {\n  position: fixed;\n  bottom: 90px; \/* keeps it above sticky ATC *\/\n  right: 16px;\n  width: 36px;\n  height: 36px;\n  background-color: #f5f5f5;\n  border-radius: 999px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.15);\n  display: none;\n  justify-content: center;\n  align-items: center;\n  z-index: 40; \/* lower than cart drawer (usually 50+) *\/\n  cursor: pointer;\n}\n\n.back-to-top img {\n  width: 18px;\n  height: 18px;\n}\n\n@media (max-width: 600px) {\n  .back-to-top {\n    width: 32px;\n    height: 32px;\n    bottom: 85px;\n    right: 12px;\n  }\n\n  .back-to-top img {\n    width: 16px;\n    height: 16px;\n  }\n}\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const backToTop = document.getElementById(\"backToTop\");\n\n  window.addEventListener(\"scroll\", function () {\n    backToTop.style.display = window.scrollY > 1200 ? \"flex\" : \"none\";\n  });\n\n  backToTop.addEventListener(\"click\", function (e) {\n    e.preventDefault();\n    window.scrollTo({ top: 0, behavior: \"smooth\" });\n  });\n});\n<\/script>"}},"liquid_A3WDKJ":{"type":"liquid","disabled":true,"settings":{"liquid":"<div id='ss-product-reviews-2'><\/div>"}},"liquid_T8eNYP":{"type":"liquid","disabled":true,"settings":{"liquid":"<div style=\"text-align: center;\">\n  <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/trustpilot_4.5_stars.png?v=1738211488\" alt=\"Trustpilot Rating\" style=\"width: 120px; height: auto; display: block; margin: 0 auto;\">\n  {% if request.path contains '\/nl' %}\n    <p style=\"font-size: 12px; margin-top: 8px; color: black;\">Beoordeeld <strong>Uitstekend<\/strong> op <a href=\"https:\/\/www.trustpilot.com\/review\/curvjeans.com\" style=\"text-decoration: underline; color: black;\">Trustpilot<\/a>.<\/p>\n  {% else %}\n    <p style=\"font-size: 12px; margin-top: 8px; color: black;  margin-bottom: 15px;\">Rated <strong>Excellent<\/strong> on <a href=\"https:\/\/www.trustpilot.com\/review\/curvjeans.com\" style=\"text-decoration: underline; color: black;\">Trustpilot<\/a>.<\/p>\n  {% endif %}\n<\/div>"}},"liquid_Yb9YLC":{"type":"liquid","disabled":true,"settings":{"liquid":"<div id=\"ss-product-reviews-2\"><\/div>"}},"associated_products_kgkJM6":{"type":"associated_products","settings":{"title":"Complete Your Perfect Fit","stack_products":true,"products_count":3,"background":"#f8f