{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>6 Reasons Your Jeans Don't Fit — And Why 10,000+ Women Quietly Switched</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      line-height: 1.65;
      color: #1a1a1a;
      background: #ffffff;
    }

    .banner {
      background: #1a1a1a;
      color: white;
      text-align: center;
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.3px;
    }

    .container {
      max-width: 100%;
      margin: 0 auto;
      background: white;
    }

    .header {
      padding: 32px 20px 24px;
      text-align: center;
      border-bottom: 1px solid #e8e8e8;
    }

    .header h1 {
      font-size: 26px;
      line-height: 1.25;
      margin-bottom: 12px;
      color: #1a1a1a;
      font-weight: 700;
    }

    .header p {
      font-size: 16px;
      color: #666666;
      line-height: 1.5;
    }

    .intro {
      padding: 24px 20px;
      background: #f5f5f5;
      font-size: 16px;
      line-height: 1.65;
      color: #1a1a1a;
    }

    .hero-image {
      width: 100%;
      height: 400px;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
      font-size: 14px;
      border-bottom: 1px solid #e8e8e8;
      text-align: center;
      padding: 20px;
    }

    .hero-social-proof {
      padding: 20px;
      background: white;
      border-bottom: 1px solid #e8e8e8;
    }

    .social-proof-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .social-proof-avatars {
      display: flex;
      align-items: center;
    }

    .social-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 2px solid white;
      margin-left: -12px;
      object-fit: cover;
    }

    .social-avatar:first-child {
      margin-left: 0;
    }

    .social-proof-text {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      color: #1a1a1a;
      margin: 0;
    }

    .social-proof-text strong {
      font-weight: 700;
    }

    .social-verified {
      width: 16px;
      height: 16px;
      object-fit: contain;
    }

    .section {
      padding: 32px 20px;
      border-bottom: 1px solid #f0f0f0;
    }

    .section:last-of-type {
      border-bottom: none;
    }

    .section h2 {
      font-size: 20px;
      margin-bottom: 16px;
      color: #1a1a1a;
      font-weight: 700;
      line-height: 1.3;
    }

    .section p {
      font-size: 16px;
      line-height: 1.65;
      color: #333333;
      margin-bottom: 16px;
    }

    .section p:last-of-type {
      margin-bottom: 0;
    }

    .section strong {
      color: #1a1a1a;
      font-weight: 700;
    }

    .section em {
      font-style: italic;
      color: #666666;
    }

    .image-placeholder {
      width: 100%;
      height: 240px;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
      font-size: 13px;
      border: 2px dashed #e0e0e0;
      margin: 20px 0;
      border-radius: 4px;
      text-align: center;
      padding: 20px;
    }

    .testimonial {
      background: #fafafa;
      padding: 16px;
      margin-top: 16px;
      border-radius: 4px;
      font-style: italic;
      color: #666666;
      font-size: 15px;
      line-height: 1.6;
      border-left: 3px solid #e0e0e0;
    }

    .testimonial strong {
      font-style: normal;
      color: #1a1a1a;
      display: block;
      margin-top: 8px;
      font-size: 14px;
      font-weight: 600;
    }

    .cta-section {
      background: #1a1a1a;
      color: white;
      padding: 40px 20px;
      text-align: center;
    }

    .cta-section h2 {
      font-size: 24px;
      margin-bottom: 12px;
      font-weight: 700;
      line-height: 1.3;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .cta-section .urgency-text {
      font-size: 15px;
      margin-bottom: 20px;
      line-height: 1.5;
    }

    .cta-section .scarcity-text {
      font-size: 14px;
      margin-bottom: 16px;
      opacity: 0.9;
    }

    .sell-out-risk {
      display: inline-block;
      background: rgba(255, 68, 68, 0.15);
      border: 1px solid #ff4444;
      padding: 8px 16px;
      border-radius: 4px;
      margin-bottom: 20px;
      font-size: 13px;
      font-weight: 600;
    }

    .free-shipping {
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 24px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .offer-box {
      background: rgba(255, 255, 255, 0.05);
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 4px;
      padding: 24px 20px;
      margin: 24px 0;
    }

    .sale-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 16px;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background: #ff4444;
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
        transform: scale(1);
      }
      50% {
        opacity: 0.5;
        transform: scale(1.2);
      }
    }

    .sale-badge span {
      font-size: 14px;
      font-weight: 600;
      color: white;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .offer-box .discount {
      font-size: 28px;
      font-weight: 700;
      color: white;
      margin-bottom: 8px;
    }

    .offer-box .urgency {
      font-size: 14px;
      margin-bottom: 20px;
      opacity: 0.9;
    }

    .confidence-boost-box {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin: 18px 0;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.9);
      flex-wrap: wrap;
    }

    .confidence-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .confidence-icon {
      width: 16px;
      height: 16px;
    }

    .cta-button {
      display: block;
      width: 100%;
      background: white;
      color: #1a1a1a;
      padding: 18px 40px;
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      border-radius: 8px;
      transition: transform 0.2s;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      text-align: center;
      border: none;
      cursor: pointer;
    }

    .cta-button:hover {
      transform: translateY(-2px);
    }

    .products-section {
      padding: 40px 20px;
      background: #fafafa;
      text-align: center;
    }

    .products-section h3 {
      font-size: 20px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .products-section p {
      font-size: 15px;
      color: #666666;
      margin-bottom: 24px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      max-width: 900px;
      margin: 0 auto;
    }

    .product-card {
      background: white;
      border-radius: 8px;
      overflow: hidden;
      text-decoration: none;
      transition: transform 0.2s;
      border: 1px solid #e8e8e8;
    }

    .product-card:hover {
      transform: translateY(-4px);
    }

    .product-image {
      width: 100%;
      height: 320px;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #999;
      font-size: 13px;
      padding: 20px;
      text-align: center;
    }

    .product-info {
      padding: 16px;
      text-align: left;
    }

    .product-label {
      font-size: 12px;
      color: #666666;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .product-name {
      font-size: 16px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 8px;
    }

    .product-price {
      font-size: 18px;
      font-weight: 700;
      color: #1a1a1a;
    }

    .risk-note {
      font-size: 13px;
      margin-top: 20px;
      opacity: 0.85;
      line-height: 1.6;
    }

    @media (min-width: 768px) {
      .container {
        max-width: 680px;
      }
      .header { padding: 40px 32px 32px; }
      .header h1 { font-size: 32px; }
      .header p { font-size: 17px; }
      .hero-image { height: 500px; }
      .section { padding: 40px 32px; }
      .cta-section { padding: 56px 32px; }
    }
  </style>
</head>
<body>
  <div class="banner">✨ Pre-Black Friday Sale — Glow Season Starts Early ✨</div>

  <div class="container">
    {% comment %} --- Your entire <body> content goes here --- {% endcomment %}
    {{ page.content }}
  </div>
</body>
</html>
