ass=\"cj-bundle-simple\">\n\n  <!-- Title -->\n  <div class=\"cj-bundle-simple-title\">\n    {% if request.path contains '\/nl' %}\n      Confidence Base Bundle – Mix & match\n    {% elsif request.path contains '\/de' %}\n      Confidence Base Bundle – Mix & Match\n    {% else %}\n      Confidence Base Bundle – Mix & match\n    {% endif %}\n  <\/div>\n\n  {% comment %}\n  Discount configuration\n{% endcomment %}\n{% assign discount_2 = 10 %}\n{% assign discount_3 = 20 %}\n\n{% comment %}\n  Raw savings in cents\n{% endcomment %}\n{% assign save_2_raw = product.price | times: discount_2 | divided_by: 100 | times: 2 %}\n{% assign save_3_raw = product.price | times: discount_3 | divided_by: 100 | times: 3 %}\n\n{% comment %}\n  Convert to rounded-up whole currency\n{% endcomment %}\n{% assign save_2 = save_2_raw | divided_by: 100.0 | plus: 0.99 | floor %}\n{% assign save_3 = save_3_raw | divided_by: 100.0 | plus: 0.99 | floor %}\n\n{% comment %}\n  Currency symbol based on active store currency\n{% endcomment %}\n{% case cart.currency.iso_code %}\n  {% when 'USD' %}\n    {% assign cur_symbol = '$' %}\n  {% when 'CAD' %}\n    {% assign cur_symbol = '$' %}\n  {% when 'GBP' %}\n    {% assign cur_symbol = '£' %}\n  {% else %}\n    {% assign cur_symbol = '€' %}\n{% endcase %}\n\n  <!-- Offer lines -->\n  <div class=\"cj-bundle-simple-lines\">\n    {% if request.path contains '\/nl' %}\n      <div>✓ 2 items – <strong>10% korting<\/strong> (bespaar {{ cur_symbol }}{{ save_2 }})<\/div>\n      <div>✓ 3 items – <strong>20% korting<\/strong> (bespaar {{ cur_symbol }}{{ save_3 }})<\/div>\n    {% elsif request.path contains '\/de' %}\n      <div>✓ 2 items – <strong>10% Rabatt<\/strong> (spare {{ cur_symbol }}{{ save_2 }})<\/div>\n      <div>✓ 3 items – <strong>20% Rabatt<\/strong> (spare {{ cur_symbol }}{{ save_3 }})<\/div>\n    {% else %}\n      <div>✓ 2 items – <strong>10% off<\/strong> (save {{ cur_symbol }}{{ save_2 }})<\/div>\n      <div>✓ 3 items – <strong>20% off<\/strong> (save {{ cur_symbol }}{{ save_3 }})<\/div>\n    {% endif %}\n  <\/div>\n\n<\/div>\n\n<style>\n.cj-bundle-simple {\n  background: #f7f7f7;\n  border-radius: 10px;\n  padding: 10px 12px;\n  margin: 14px 0 18px;\n}\n\n.cj-bundle-simple-title {\n  font-size: 14px;\n  font-weight: 700;\n  color: #111;\n  margin-bottom: 0px;\n}\n\n.cj-bundle-simple-lines {\n  font-size: 13.5px;\n  color: #111;\n  line-height: 1.5;\n}\n\n.cj-bundle-simple-lines strong {\n  font-weight: 700;\n}\n\n@media (max-width: 600px) {\n  .cj-bundle-simple-title {\n    font-size: 13px;\n  }\n\n  .cj-bundle-simple-lines {\n    font-size: 13px;\n  }\n}\n<\/style>"}},"liquid_mqmqy8":{"type":"liquid","settings":{"liquid":"{% render 'cj-shp-compression' %}"}},"kiwi_size_chart_recommender_kiwi_sizing_zVwWrC":{"type":"shopify:\/\/apps\/kiwi-size-chart-recommender\/blocks\/kiwiSizing\/b7369922-bf15-44ce-a121-a22a8fcbc4b0","settings":{"fallbackToBlockPosition":false,"waitForElementSelector":"","waitForElementDelay":5}},"collapsible_text_xrHaci":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Compression Level","content":"","page":""}},"collapsible_text_7KYfLw":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Description","content":"{{ product.description }}","page":""}},"collapsible_text_rcQ8QH":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Size & Confidence Guarantee","content":"<p>Not sure which size will sculpt your shape? Take our <strong>15-second Fit Quiz<\/strong> right under the size picker for instant guidance.<\/p><ul><li>Shapewear always looks small when you unpack it — that’s normal. It’s built to stretch, sculpt, and hug your curves.<\/li><li>Order your usual size for a snatched, sculpted effect. Prefer a little more comfort for all-day wear? Size up.<br\/><br\/>And don’t stress: if it doesn’t make you feel confident, our <strong>Confidence Guarantee<\/strong> means you can exchange it free until it does. <\/li><\/ul>","page":""}},"collapsible_text_XtCTEg":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Shipping & Returns","content":"<p>Delivered to you in 4-6 working days, track & trace code included. Free shipping above €80. <br\/><br\/>We offer a 14 day return or exchange policy, no questions asked! Simply start your own return <a href=\"https:\/\/curvjeans.returnless.com\/nl\" target=\"_blank\" title=\"https:\/\/curvjeans.returnless.com\/\">here.<\/a><\/p>","page":""}},"collapsible_text_HUDbb7":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"FAQ","content":"<p><strong>How do I know which size to pick?<\/strong><br\/>Shapewear sizing can feel tricky, we get it. Just use our 15-second Fit Quiz or check the Size Guide — we list real measurements, so you’ll know exactly what works for your shape. Still unsure? <strong>Exchanges are free<\/strong> until you find the perfect fit.<\/p><p><strong>Will it roll down?<\/strong><br\/>No. Our Seamless Snatched bodysuit is designed with a grip band and compression that actually stays in place. No awkward tugging, no rolling. Just smooth support that moves with you.<br\/><br\/><strong>Can I wear it all day?<\/strong><br\/>Yes! We made sure the fabric is breathable and soft so you can feel sculpted without feeling suffocated. Snatched enough for a night out, comfy enough for a full day.<\/p><p><strong>How do I go to the bathroom in it?<\/strong><br\/>We thought of that. The snap closure at the gusset makes bathroom breaks quick and easy. No need to take everything off.<br\/><br\/><strong>Will it show under clothes?<\/strong><br\/>Nope. The seamless design disappears under dresses, jeans, or even tight tops. It’s your invisible confidence booster.<\/p>","page":""}},"liquid_papGaB":{"type":"liquid","disabled":true,"settings":{"liquid":"<!-- Back to Top Button -->\n<a href=\"#top\" class=\"back-to-top\" id=\"backToTop\" aria-label=\"Back to top\">\n  <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/arrow-up-svgrepo-com.svg?v=1743044799\" alt=\"Back to top\">\n<\/a>\n\n<style>\n.back-to-top {\n  position: fixed;\n  bottom: 90px; \/* keeps it above sticky ATC *\/\n  right: 16px;\n  width: 36px;\n  height: 36px;\n  background-color: #f5f5f5;\n  border-radius: 999px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.15);\n  display: none;\n  justify-content: center;\n  align-items: center;\n  z-index: 40; \/* lower than cart drawer (usually 50+) *\/\n  cursor: pointer;\n}\n\n.back-to-top img {\n  width: 18px;\n  height: 18px;\n}\n\n@media (max-width: 600px) {\n  .back-to-top {\n    width: 32px;\n    height: 32px;\n    bottom: 85px;\n    right: 12px;\n  }\n\n  .back-to-top img {\n    width: 16px;\n    height: 16px;\n  }\n}\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const backToTop = document.getElementById(\"backToTop\");\n\n  window.addEventListener(\"scroll\", function () {\n    backToTop.style.display = window.scrollY > 1200 ? \"flex\" : \"none\";\n  });\n\n  backToTop.addEventListener(\"click\", function (e) {\n    e.preventDefault();\n    window.scrollTo({ top: 0, behavior: \"smooth\" });\n  });\n});\n<\/script>"}},"liquid_A3WDKJ":{"type":"liquid","disabled":true,"settings":{"liquid":"<div id='ss-product-reviews-2'><\/div>"}},"liquid_T8eNYP":{"type":"liquid","disabled":true,"settings":{"liquid":"<div style=\"text-align: center;\">\n  <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/trustpilot_4.5_stars.png?v=1738211488\" alt=\"Trustpilot Rating\" style=\"width: 120px; height: auto; display: block; margin: 0 auto;\">\n  {% if request.path contains '\/nl' %}\n    <p style=\"font-size: 12px; margin-top: 8px; color: black;\">Beoordeeld <strong>Uitstekend<\/strong> op <a href=\"https:\/\/www.trustpilot.com\/review\/curvjeans.com\" style=\"text-decoration: underline; color: black;\">Trustpilot<\/a>.<\/p>\n  {% else %}\n    <p style=\"font-size: 12px; margi