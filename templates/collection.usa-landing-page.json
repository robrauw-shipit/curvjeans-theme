24px; \/* ORIGINAL desktop gap *\/\n  }\n\n  \/* Desktop cards = original padding *\/\n  .cj-rb-card {\n    min-width:calc(33.333% - 16px);\n    padding:22px 20px;  \/* ORIGINAL DESKTOP PADDING *\/\n  }\n}\n\/* MOBILE FIX — make slider show exactly 1 card with no peek *\/\n@media(max-width: 768px){\n\n  .cj-rb-slider-container {\n    overflow:hidden; \/* ensures nothing peeks out *\/\n    padding:0;       \/* remove any parent padding that causes reveal *\/\n  }\n\n  .cj-rb-slider {\n    gap:0 !important;      \/* remove card spacing *\/\n  }\n\n  .cj-rb-card {\n    min-width:100% !important; \/* true full width card *\/\n    margin:0 !important;       \/* remove extra spacing *\/\n    border-radius:12px;\n    padding:24px 20px;         \/* inner padding only *\/\n    box-shadow:0 2px 12px rgba(0,0,0,0.06);\n  }\n}\n\n<\/style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  \n  const slider = document.querySelector('.cj-rb-slider');\n  const next = document.querySelector('.cj-next');\n  const prev = document.querySelector('.cj-prev');\n\n  next.addEventListener('click', () => {\n    slider.scrollBy({ left: slider.offsetWidth, behavior: 'smooth' });\n  });\n\n  prev.addEventListener('click', () => {\n    slider.scrollBy({ left: -slider.offsetWidth, behavior: 'smooth' });\n  });\n\n});\n<\/script>","background":"","background_gradient":"","text_color":""}},"custom_liquid_QCpKYn":{"type":"custom-liquid","name":"Custom Liquid","settings":{"full_width":true,"remove_vertical_spacing":true,"remove_horizontal_spacing":false,"liquid":"<div class=\"cj-sizehelp-section\">\n\n  <!-- LEFT: IMAGE (desktop only) -->\n  <div class=\"cj-sizehelp-image\">\n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/curvjeans20-09-2025-2_0019_curvjeans20-09-2025-87.jpg?v=1759138259\" \n    alt=\"Curvjeans Fit Image\">\n  <\/div>\n\n  <!-- RIGHT: CARD -->\n  <div class=\"cj-sizehelp-wrapper\">\n\n    <h2 class=\"cj-sizehelp-title\">What