iles\/1\/0864\/5165\/0895\/files\/verified.webp?v=1726649878\"\n               alt=\"Verified Badge\"\n               class=\"verified-badge\" \/>\n        <\/p>\n      <\/div>\n    <\/div>\n\n    <!-- Image -->\n    <div class=\"listicle-image\"\n         style=\"background-image:url('https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/1_d00f0fbe-920f-447b-b6bc-7a64acbdede1.jpg?v=1755796891');\">\n    <\/div>\n  <\/div>\n<\/section>","background":"","background_gradient":"","text_color":""}},"custom_liquid_QAN3BU":{"type":"custom-liquid","name":"Custom Liquid","settings":{"full_width":true,"remove_vertical_spacing":true,"remove_horizontal_spacing":true,"liquid":"<section class=\"curvjeans-listicle-item\">\n  <div class=\"listicle-grid\">\n    <!-- Image -->\n    <div class=\"listicle-image\"\n         style=\"background-image:url('https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/booty_lifting_curvjeans.webp?v=1753345060');\">\n    <\/div>\n\n    <!-- Text -->\n    <div class=\"listicle-content\">\n      <h2 class=\"listicle-number\">3.<\/h2>\n\n      <h3 class=\"listicle-title\">\n        {% if request.path contains '\/nl' %}\n          Je Ziet Het Verschil Direct\n        {% else %}\n          You’ll See the Difference\n        {% endif %}\n      <\/h3>\n\n      <p class=\"listicle-text\">\n        {% if request.path contains '\/nl' %}\n          Booty‑lifting design, gap‑proof tailleband, flatterende pijpen — CURVJEANS is ontworpen om je figuur zichtbaar te sculpteren. Verwacht compliments.\n        {% else %}\n          Booty‑lifting seams, gap‑proof waistband, flattering leg cuts — CURVJEANS is designed to visibly sculpt your shape. Expect compliments.\n        {% endif %}\n      <\/p>\n\n      <div class=\"listicle-testimonial\">\n        <p class=\"testimonial-quote\">\n          {% if request.path contains '\/nl' %}\n            “Mijn vriend zag het letterlijk na 5 minuten, nog nooit jeans gehad die me zo liften.”\n          {% e