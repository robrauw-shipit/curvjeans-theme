        "remove_horizontal_spacing": true,
        "liquid": "\n<style>\n.cj-adv{--ink:#111;--ink-2:#2a2a2a;--ink-3:#555;--ink-4:#777;--panel:#f7f7f7;--accent:#e48175;--line:rgba(17,17,17,.13);--radius:.75rem;font-family:inherit;color:var(--ink);line-height:1.65;-webkit-font-smoothing:antialiased}\n.cj-adv *{box-sizing:border-box}\n.cj-adv img{display:block;max-width:100%}\n.cj-adv a{color:inherit;text-decoration:none}\n.cj-adv .col{max-width:720px;margin:0 auto;padding:0 20px}\n.cj-adv h1,.cj-adv h2,.cj-adv h3{font-family:inherit;font-weight:700;letter-spacing:-.01em;line-height:1.18;margin:0;color:var(--ink)}\n.cj-adv p{margin:0}\n.cj-adv .stars{color:var(--accent);letter-spacing:2px;line-height:1}\n.cj-adv .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:inherit;font-weight:700;font-size:1rem;min-height:52px;padding:1rem 1.8rem;border-radius:var(--radius);background:var(--ink);color:#fff;border:none;cursor:pointer;text-decoration:none;transition:.15s;width:100%;text-align:center}\n.cj-adv .btn:hover{opacity:.88}\n.cj-adv .eyebrow{font-family:inherit;font-weight:700;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}\n\n/* disclosure + masthead */\n.cj-adv .adv-bar{background:var(--panel);border-bottom:1px solid var(--line);font-family:inherit;font-weight:600;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-4);text-align:center;padding:.55rem}\n.cj-adv .masthead{border-bottom:1px solid var(--line);background:#fff}\n.cj-adv .masthead .col{display:flex;align-items:center;justify-content:space-between;height:60px}\n.cj-adv .masthead img{height:22px;width:auto}\n.cj-adv .masthead .tag{font-family:inherit;font-weight:700;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-4)}\n\n/* article header */\n.cj-adv article{padding:30px 0 10px}\n.cj-adv .kicker{margin-bottom:14px;display:block}\n.cj-adv h1.title{font-size:clamp(1.7rem,5.4vw,2.5rem);line-height:1.18;margin-bottom:16px}\n.cj-adv .dek{font-size:1.18rem;line-height:1.55;color:var(--ink-3);margin-bottom:22px}\n.cj-adv .byline{display:flex;align-items:center;gap:12px;font-size:.9rem;color:var(--ink-4);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:13px 0;margin-bottom:26px}\n.cj-adv .byline .av{width:36px;height:36px;border-radius:50%;background:var(--panel) center/cover;flex:none}\n.cj-adv .byline b{color:var(--ink);font-weight:600}\n.cj-adv .byline .star{margin-left:auto}\n\n.cj-adv figure{margin:26px 0}\n.cj-adv figure img{width:100%;border-radius:14px}\n.cj-adv figcaption{font-size:.86rem;color:var(--ink-4);text-align:center;margin-top:10px;font-style:italic}\n\n.cj-adv p.body{font-size:1.12rem;line-height:1.65;margin:18px 0;color:var(--ink-2)}\n.cj-adv p.body strong{color:var(--ink);font-weight:600}\n\n.cj-adv .pull{font-style:italic;font-weight:500;font-size:1.4rem;line-height:1.4;color:var(--ink);border-left:3px solid var(--accent);padding:8px 0 8px 22px;margin:32px 0}\n\n/* listicle items */\n.cj-adv .item{margin:40px 0;padding-top:32px;border-top:1px solid var(--line)}\n.cj-adv .item .num{display:inline-flex;align-items:center;gap:12px;margin-bottom:12px}\n.cj-adv .item .num span{width:38px;height:38px;border-radius:50%;background:var(--ink);color:#fff;font-family:inherit;font-weight:800;display:grid;place-items:center;font-size:1.05rem;flex:none}\n.cj-adv .item .num em{font-style:normal;font-family:inherit;font-weight:700;font-size:.76rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}\n.cj-adv .item h2{font-size:clamp(1.3rem,3.6vw,1.6rem);line-height:1.25;margin-bottom:12px}\n\n/* inline cta card */\n.cj-adv .cta-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:26px;margin:36px 0;text-align:center}\n.cj-adv .cta-card .price{font-family:inherit;font-weight:800;font-size:1.1rem;margin:8px 0 14px}\n.cj-adv .cta-card .price s{color:var(--ink-4);font-weight:500;margin-left:8px}\n.cj-adv .cta-card small{display:block;color:var(--ink-4);font-size:.85rem;margin-top:12px}\n.cj-adv .cta-card .btn{max-width:420px;margin:0 auto}\n\n/* proof grid */\n.cj-adv .proof{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0}\n.cj-adv .proof figure{margin:0}\n.cj-adv .proof .lbl{font-family:inherit;font-weight:700;font-size:.78rem;letter-spacing:.04em;text-align:center;margin-top:10px;color:var(--ink-2)}\n\n/* reviews */\n.cj-adv .reviews{background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:44px 0;margin:44px 0}\n.cj-adv .rev{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px;margin:14px 0}\n.cj-adv .rev .s{font-size:.95rem;margin-bottom:8px}\n.cj-adv .rev blockquote{font-size:1.06rem;line-height:1.5;margin:0;color:var(--ink-2)}\n.cj-adv .rev .who{font-family:inherit;font-weight:600;font-size:.84rem;color:var(--ink-4);margin-top:12px}\n\n/* faq */\n.cj-adv .faq{margin:16px 0}\n.cj-adv .faq details{border-bottom:1px solid var(--line);padding:16px 0}\n.cj-adv .faq summary{font-family:inherit;font-weight:700;font-size:1.05rem;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:12px;align-items:center}\n.cj-adv .faq summary::-webkit-details-marker{display:none}\n.cj-adv .faq summary::after{content:\"+\";color:var(--accent);font-weight:800;font-size:1.2rem}\n.cj-adv .faq details[open] summary::after{content:\"\\2013\"}\n.cj-adv .faq p{margin-top:12px;color:var(--ink-3);font-size:1.02rem;line-height:1.6}\n\n/* offer (dark, white + rose accents) */\n.cj-adv .offer{background:var(--ink);color:#fff;border-radius:18px;padding:36px 26px;margin:32px 0;text-align:center}\n.cj-adv .offer .eyebrow{color:var(--accent)}\n.cj-adv .offer h2{color:#fff;font-size:clamp(1.5rem,4vw,2rem);margin:12px 0 8px}\n.cj-adv .offer p{color:rgba(255,255,255,.82);margin-bottom:20px;font-size:1.05rem}\n.cj-adv .tiers{display:flex;gap:10px;justify-content:center;margin:18px 0 24px;flex-wrap:wrap}\n.cj-adv .tier{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:16px 20px;min-width:100px}\n.cj-adv .tier b{display:block;font-family:inherit;font-weight:800;font-size:1.6rem;color:#fff}\n.cj-adv .tier small{font-size:.74rem;color:rgba(255,255,255,.72);text-transform:uppercase;letter-spacing:.06em}\n.cj-adv .offer .btn{background:#fff;color:var(--ink);max-width:380px;margin:0 auto}\n.cj-adv .stock{font-size:.88rem;color:var(--accent);margin-top:16px;font-weight:600}\n\n.cj-adv .note{padding:32px 0 40px;color:var(--ink-4);font-size:.82rem;text-align:center;line-height:1.5}\n\n/* DESKTOP */\n@media(min-width:769px){\n  .cj-adv .col{padding:0 22px}\n  .cj-adv article{padding:40px 0 10px}\n  .cj-adv .dek{font-size:1.3rem}\n  .cj-adv p.body{font-size:1.15rem}\n  .cj-adv .pull{font-size:1.55rem}\n}\n</style>\n\n<div class=\"cj-adv\">\n\n  <div class=\"adv-bar\">Advertorial · Presented by CURVJEANS</div>\n  <div class=\"masthead\">\n    <div class=\"col\">\n      <img src=\"https://curvjeans.com/cdn/shop/files/CURVJEANS_BLACK.png?v=1756437552&width=405\" alt=\"CURVJEANS\">\n      <span class=\"tag\">Real Fits · Real Reviews</span>\n    </div>\n  </div>\n\n  <article class=\"col\">\n    <span class=\"kicker eyebrow\">Curve denim · honest review</span>\n    <h1 class=\"title\">I Have a Small Waist and Fuller Hips. These Are the First Jeans That Fit Both.</h1>\n    <p class=\"dek\">For years I sized up for my hips and just lived with a waistband that gaped and dug in. Then I tried CURVJEANS, and for the first time one pair fit both ends at once.</p>\n    <div class=\"byline\">\n      <span class=\"av\" style=\"background-image:url('https://curvjeans.com/cdn/shop/files/Model1-Straight2.jpg?v=1777822491&width=200')\"></span>\n      <div>By <b>Mia R.</b> · Updated June 2026 · 4 min read</div>\n      <div class=\"star stars\">★★★★★</div>\n    </div>\n\n    <figure>\n      <img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=1000\" alt=\"Back view of CURVJEANS, waistband sitting flat with no gap\">\n      <figcaption>The thing I check first on every pair: does the back gap when I turn around? It did not.</figcaption>\n    </figure>\n\n    <p class=\"body\">I have a small waist and fuller hips, and finding jeans that fit both has always felt impossible. My hips usually need a <strong>size 16</strong> and my waist is more like a <strong>12</strong>. So I would size up, the waist would gape, and I would spend the whole day hitching them up or hiding the gap with a belt.</p>\n    <p class=\"body\">Honestly, I had given up. Every pair made me choose: fits the thighs or fits the waist, never both. The bigger size never actually looked good either. Then a pair of CURVJEANS showed up on my feed. I was skeptical (aren't we all), but I am wearing a <strong>size L</strong> in these, and the second I pulled them on I knew.</p>\n\n    <p class=\"pull\">\"The second I pulled them on I knew. Flat at the waist, room in the hips, finally.\"</p>\n\n    <p class=\"body\">Here is exactly what is different, and why they are the only jeans I reach for now.</p>\n\n    <div class=\"item\">\n      <div class=\"num\"><span>1</span><em>The waist gap</em></div>\n      <h2>The waistband actually sits flat. No gap, no belt.</h2>\n      <p class=\"body\">This is the whole thing for me. The waistband is cut to curve in and follow your lower back instead of standing away from it, so there is no empty pocket of fabric gaping behind you. I turned around in the mirror waiting for the usual gap. Nothing. <strong>No belt, all day.</strong></p>\n      <figure><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_dd945a50-d4cf-4769-b11a-48db9c6c18f0.jpg?v=1781166162&width=1000\" alt=\"CURVJEANS waistband sitting flush against the lower back\"></figure>\n    </div>\n\n    <div class=\"item\">\n      <div class=\"num\"><span>2</span><em>Hips and thighs</em></div>\n      <h2>They fit my hips and thighs without a loose waist</h2>\n      <p class=\"body\">The room is built into the hips, thighs and seat, not faked by going up two sizes. So I get space exactly where I need it and a waist that still holds. No wiggle dance to get them over my thighs, no swimming in the waistband. They just <strong>fit both ends at once.</strong></p>\n    </div>\n\n    <div class=\"item\">\n      <div class=\"num\"><span>3</span><em>The fabric</em></div>\n      <h2>The denim moves with me, then holds its shape</h2>\n      <p class=\"body\">It is soft and stretchy enough that I forget I am wearing jeans, but here is the part that surprised me: it <strong>holds.</strong> So many stretchy jeans bag out and sag by 5pm. These snap back, so they look the same at dinner as they did this morning. No baggy knees, no sliding down.</p>\n      <figure><img src=\"https://curvjeans.com/cdn/shop/files/MidRise-Black11.jpg?v=1780213356&width=1000\" alt=\"Black wash CURVJEANS stretch denim\"></figure>\n    </div>\n\n    <div class=\"item\">\n      <div class=\"num\"><span>4</span><em>The real test</em></div>\n      <h2>I can sit down and they do not dig in</h2>\n      <p class=\"body\">The real test of any jean is sitting down. With my old pairs, sitting meant the waistband digging into my stomach and the back gaping wide open. In these I can sit, bend and drive, and they <strong>do not dig in at all.</strong> That alone sold me.</p>\n      <p class=\"pull\">\"I can sit down and they do not dig in. Honestly the most comfortable jeans I own.\"</p>\n    </div>\n\n    <div class=\"item\">\n      <div class=\"num\"><span>5</span><em>Sizing and washes</em></div>\n      <h2>I sized down, and they come in every wash</h2>\n      <p class=\"body\">Quick tip: the denim is generous, so if you are between sizes, <strong>size down.</strong> They will feel snug on the first wear and settle in perfectly. I am in the Indigo Wide Leg, but there is a lighter wash too and it is the same story: flat at the waist, soft and stretchy all day. I have basically stopped wearing anything else.</p>\n      <div class=\"proof\">\n        <figure><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=600\" alt=\"Indigo wide leg CURVJEANS\"><div class=\"lbl\">Indigo Wide Leg</div></figure>\n        <figure><img src=\"https://curvjeans.com/cdn/shop/files/Model1-Straight2.jpg?v=1777822491&width=600\" alt=\"Lighter wash CURVJEANS\"><div class=\"lbl\">Lighter wash, same fit</div></figure>\n      </div>\n    </div>\n\n    <div class=\"cta-card\">\n      <div class=\"eyebrow\">Shop the pair from this review</div>\n      <div class=\"price\">Wide Leg · Mid Rise · Indigo. $69.97 <s>$99.95</s></div>\n      <a class=\"btn\" href=\"#cj-adv-offer\">Check if my size is in stock</a>\n      <small>Free size swaps until they fit · 14 day returns</small>\n    </div>\n  </article>\n\n  <div class=\"reviews\">\n    <div class=\"col\">\n      <div class=\"eyebrow\" style=\"text-align:center\">Not just me</div>\n      <h2 style=\"text-align:center;font-size:1.5rem;margin:8px 0 4px\">Reviews from women shaped like me</h2>\n      <div class=\"rev\"><div class=\"s stars\">★★★★★</div>\n        <blockquote>\"I am a 16 in the hips and a 12 in the waist. These fit over both, and I have not touched a belt since.\"</blockquote>\n        <div class=\"who\">Size L, 5'5\", curvy</div></div>\n      <div class=\"rev\"><div class=\"s stars\">★★★★★</div>\n        <blockquote>\"Stretchy but they actually hold their shape. I did not have to change out of them by 5pm for once.\"</blockquote>\n        <div class=\"who\">Size 14, full hips and thighs</div></div>\n      <div class=\"rev\"><div class=\"s stars\">★★★★★</div>\n        <blockquote>\"Every other pair gaps at my back. First jeans that sit flat when I sit down. I bought two more.\"</blockquote>\n        <div class=\"who\">Size 18, small waist, full seat</div></div>\n    </div>\n  </div>\n\n  <div class=\"col\">\n    <div class=\"eyebrow\">Before you order</div>\n    <h2 style=\"font-size:1.5rem;margin:8px 0 12px\">The questions I had too</h2>\n    <div class=\"faq\">\n      <details open><summary>Will they really not gap at the back?</summary><p>That is the whole point of the cut. The waistband is shaped to follow your lower back. If your hip to waist difference is on the bigger side, this is the fit made for you.</p></details>\n      <details><summary>Do they stretch out and go baggy?</summary><p>No. The stretch is built to recover, so they snap back instead of sagging by the end of the day.</p></details>\n      <details><summary>What size should I order?</summary><p>True to size, but the denim is stretchy. If you are between sizes, size down. Snug on the first wear is normal and correct.</p></details>\n      <details><summary>What if the fit is not right?</summary><p>Free size swaps until they fit, plus 14 day returns. There is no risk in trying your size.</p></details>\n    </div>\n  </div>\n\n  <div class=\"col\" id=\"cj-adv-offer\">\n    <div class=\"offer\">\n      <div class=\"eyebrow\">One catch</div>\n      <h2>There is a big sale on right now</h2>\n      <p>So go check if your size is still in before it is gone.</p>\n      <div class=\"tiers\">\n        <div class=\"tier\"><b>30%</b><small>1 pair</small></div>\n        <div class=\"tier\"><b>40%</b><small>2 pairs</small></div>\n        <div class=\"tier\"><b>50%</b><small>3 pairs</small></div>\n      </div>\n      <a class=\"btn\" href=\"/collections/all-products\">Shop the no gap fit</a>\n      <div class=\"stock\">Selling fast. Popular sizes (L, 14, 16) are low in stock.</div>\n    </div>\n  </div>\n\n  <div class=\"note col\">\n    Advertorial presented by CURVJEANS. Individual results and fit vary by body. Review quotes reflect real customer themes.\n  </div>\n\n</div>\n",
