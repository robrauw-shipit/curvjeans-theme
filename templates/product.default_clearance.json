ackground_gradient":"","border_color":"#000000","margin_top":28,"margin_bottom":52,"padding_top":0,"padding_bottom":0,"padding_horizontal":0,"padding_horizontal_mobile":10,"border_thickness":0,"lazy":true}},"faq_7HFiiR":{"type":"faq","blocks":{"item_qMqCQK":{"type":"item","settings":{"title":"How do I know if CURVJEANS will fit me?","content":"<p>We get it, finding jeans that <em>actually<\/em> fit is a struggle. That’s why CURVJEANS are designed specifically for smaller waists and wider hips. <br\/><br\/>Check our <a href=\"\/pages\/size-guide\" target=\"_blank\" title=\"Size Guide\">size guide<\/a> with real measurements and do our fit quiz or simply DM us! Still unsure? Our returns are super easy. <\/p>"}},"item_Q6t3qz":{"type":"item","settings":{"title":"What if I’m between sizes?","content":"<p>If you're in between, we usually recommend sizing down, our denim is <strong>super stretchy<\/strong> and molds to your body after a few wears. Still unsure? Check our size guide or do our fit quiz.<\/p>"}},"item_apnfpL":{"type":"item","settings":{"title":"Are they really that comfortable?","content":"<p>YES. CURVJEANS feel like your favorite leggings but look like your best jeans. No stiff fabrics, no digging in, just <strong>all-day comfort<\/strong> and the stretch you’ve been craving.<\/p>"}},"item_JxRWDf":{"type":"item","settings":{"title":"Will they lose shape after wearing?","content":"<p>Nope! Our premium stretch denim has a <em>bounce-back effect<\/em> — it hugs your curves without stretching out or sagging over time.<\/p>"}},"item_LAwTPK":{"type":"item","settings":{"title":"What if they're not the one?","content":"<p>You can easily return them within 14-day after receiving or exchange them for a different style for free.<\/p>"}},"item_JQn3wx":{"type":"item","disabled":true,"settings":{"title":"Can I pay later?","content":"<p>Yep! Just select Klarna at checkout and you can try now, pay later—no extra fees. Super easy, super safe.<\/p>"}},"item_crpTfx":{"type":"item","settings":{"title":"When will I receive my order?","content":"<p>Can't wait to get your perfect jeans? We get it! Your CURVJEANS will arrive in 4-6 working days. We'll keep you updated every step of the way with a tracking code.<\/p>"}},"item_ATGjTb":{"type":"item","settings":{"title":"Do you ship internationally?","content":"<p>Yes we do! See the shipping tab for more information.<\/p>"}}},"block_order":["item_qMqCQK","item_Q6t3qz","item_apnfpL","item_JxRWDf","item_LAwTPK","item_JQn3wx","item_crpTfx","item_ATGjTb"],"settings":{"full_width":true,"subheading":"","title":"FAQ","content":"<p>Your Fit. Your Questions. Answered.<\/p>","team_avatar_width":160,"support_hours":"Our customer support is available Monday to Friday: 8am-6pm via help@curvjeans.com","answer_time":"Average answer time: 24h","button_text":"","button_url":"","text_position":"center","background":"rgba(0,0,0,0)","background_gradient":"","text_color":"","heading_color":"","heading_gradient":"","button_background":"","button_text_color":"","accordion_background":"#f9f9f9","accordion_text_color":""}},"17617046648e7094bb":{"type":"apps","settings":{"full_width":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"background":"","background_gradient":"","text_color":""}}},"order":["main","related_products_xwmcwE","featured_collection_PnfjdC","product_reviews_2_VBWwQR","faq_7HFiiR","17617046648e7094bb"]}