  {% endif %}\n    {% else %}\n      <span class=\"stock-indicator red pulse\"><\/span>\n      <span class=\"usp-text stock-text red-text\">Out of stock<\/span>\n    {% endif %}\n  <\/div>\n\n<\/div>\n\n<!-- Styles (Fixed Mobile Pop-up & Increased Margins) -->\n<style>\n  .product-usps {\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n    margin-bottom: 15px !important; \/* Space BELOW all USPs *\/\n    margin-top: 15px !important; \/* Space ABOVE all USPs *\/\n    padding: 5px 5px; \/* Padding inside the USP container *\/\n  }\n\n  .usp-item {\n    display: flex;\n    align-items: center;\n    font-size: var(--text-base-size);\n    color: #000;\n    position: relative;\n    gap: 8px;\n  }\n\n  .return-icon {\n    width: 16px;\n    height: 16px;\n  }\n\n  .usp-text {\n    font-weight: 400;\n  font-size: var(--text-base-size);\n  }\n\n  .stock-text {\n    font-weight: 500;\n  }\n\n  .info-icon {\n    font-size: var(--text-base-size);\n    font-weight: 700;\n    cursor: pointer;\n    color: #555;\n    position: relative;\n  }\n\n  .info-icon:hover {\n    color: #000;\n  }\n\n  \/* Stock Indicator *\/\n  .stock-indicator {\n    display: inline-block;\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    position: relative;\nmargin-right: 8px;\n  }\n\n  .pulse {\n    animation: pulse-animation 2.5s infinite ease-in-out;\n  }\n\n  @keyframes pulse-animation {\n    0% { transform: scale(0.9); opacity: 0.7; }\n    50% { transform: scale(1.1); opacity: 1; }\n    100% { transform: scale(0.9); opacity: 0.7; }\n  }\n\n  .green { background-color: #00A341; box-shadow: 0 0 8px rgba(0, 163, 65, 0.5); }\n  .orange { background-color: #FFA500; box-shadow: 0 0 8px rgba(255, 165, 0, 0.5); }\n  .red { background-color: #D52C2C; box-shadow: 0 0 8px rgba(213, 44, 44, 0.5); }\n\n  .green-text { color: #00A341; }\n  .orange-text { color: #FFA500; }\n  .red-text { color: #D52C2C; }\n\n  \/* Pop-up *\/\n  .popup {\n    display: none;\n    position: absolute;\n    left: 50%;\n    transform: translateX(-50%);\n    top: -50px;\n    background: #fff;\n    padding: 12px;\n    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);\n    border-radius: 8px;\n    font-size: 14px;\n    text-align: left;\n    line-height: 1.5;\n    z-index: 9999;\n    max-width: 260px;\n    word-wrap: break-word;\n    white-space: normal;\n  }\n\n  .popup::before {\n    content: \"\";\n    position: absolute;\n    bottom: -6px;\n    left: 50%;\n    transform: translateX(-50%);\n    border-width: 6px;\n    border-style: solid;\n    border-color: #fff transparent transparent transparent;\n  }\n\n  \/* Pop-up for Mobile (Positioned More to the Right) *\/\n  @media (max-width: 768px) {\n    .popup {\n      top: auto;\n      bottom: -40px;\n      left: auto;\n      right: 10%;\n      transform: translateX(0%);\n      max-width: 220px;\n    }\n\n    .popup::before {\n      bottom: auto;\n      top: -6px;\n      left: 20%;\n      border-color: transparent transparent #fff transparent;\n    }\n  }\n<\/style>\n\n<!-- JavaScript (Mobile Click Fix & Desktop Hover) -->\n<script>\n  function toggleReturnPopup(event) {\n    var popup = document.getElementById(\"return-popup\");\n\n    \/\/ Toggle visibility\n    if (popup.style.display === \"block\") {\n      popup.style.display = \"none\";\n    } else {\n      popup.style.display = \"block\";\n\n      \/\/ Close when clicking outside on mobile\n      setTimeout(() => {\n        document.addEventListener(\"click\", closePopupOutside);\n      }, 100);\n    }\n  }\n\n  let popupTimeout;\n\nfunction showReturnPopup(event) {\n  if (window.innerWidth > 768) { \/\/ Only activate hover on desktop\n    clearTimeout(popupTimeout); \/\/ Prevent immediate hiding\n    var popup = document.getElementById(\"return-popup\");\n    popup.style.display = \"block\";\n  }\n}\n\nfunction hideReturnPopup() {\n  if (window.innerWidth > 768) { \/\/ Only hide after a short delay\n    popupTimeout = setTimeout(() => {\n      var popup = document.getElementById(\"return-popup\");\n      popup.style.display = \"none\";\n    }, 300); \/\/ Delay of 300ms before hiding\n  }\n}\n\n\/\/ Prevent flickering when moving from icon to popup\ndocument.getElementById(\"return-popup\").addEventListener(\"mouseenter\", function () {\n  clearTimeout(popupTimeout);\n});\n\ndocument.getElementById(\"return-popup\").addEventListener(\"mouseleave\", function () {\n  hideReturnPopup();\n});\n\n  function closePopupOutside(event) {\n    var popup = document.getElementById(\"return-popup\");\n    if (!event.target.classList.contains(\"info-icon\") && event.target !== popup) {\n      popup.style.display = \"none\";\n      document.removeEventListener(\"click\", closePopupOutside);\n    }\n  }\n\n  \/\/ Detect if URL contains \"\/nl\" and change text dynamically\n  document.addEventListener(\"DOMContentLoaded\", function () {\n  function translateToDutch() {\n    if (window.location.pathname.includes(\"\/nl\")) {\n      let returnText = document.querySelector(\".return-text\");\n      let popupText = document.querySelector(\".popup-text\");\n      let stockText = document.querySelector(\".stock-text\");\n\n      if (returnText) returnText.textContent = \"14 dagen gemakkelijk retour\";\n      if (popupText) popupText.textContent = \"Wij bieden een retour- of omruilbeleid van 14 dagen, als je om wat voor reden ontevreden bent!\";\n      if (stockText) {\n        if (stockText.dataset.originalText == null) {\n          stockText.dataset.originalText = stockText.textContent; \/\/ Store original text\n        }\n\n        if (stockText.dataset.originalText.includes(\"In stock\")) {\n          stockText.textContent = \"Op voorraad, klaar voor verzending\";\n        } else if (stockText.dataset.originalText.includes(\"Only a few\")) {\n          stockText.textContent = \"Nog maar een paar jeans over\";\n        } else if (stockText.dataset.originalText.includes(\"Out of stock\")) {\n          stockText.textContent = \"Uitverkocht\";\n        }\n      }\n    }\n  }\n\n  \/\/ Run translation function on page load\n  translateToDutch();\n\n  \/\/ Observe Shopify changes & instantly translate\n  let observer = new MutationObserver(function () {\n    translateToDutch();\n  });\n\n  let targetNode = document.querySelector(\".product-usps\");\n  if (targetNode) {\n    observer.observe(targetNode, { childList: true, subtree: true });\n  }\n\n  \/\/ Ensure translation persists on variant selection\n  document.addEventListener(\"change\", function (event) {\n    if (event.target.matches(\"[name='id']\")) {\n      setTimeout(translateToDutch, 10); \/\/ Small delay to ensure translation happens immediately\n    }\n  });\n});\n\n<\/script>"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_payment_button":false,"show_gift_card_recipient":true,"atc_button_background":"#1a1a1a","atc_button_text_color":"#ffffff","payment_button_background":"","payment_button_text_color":""}},"liquid_imcndA":{"type":"liquid","settings":{"liquid":"{% render 'clearance-noreturns-pdp' %}"}},"liquid_TDK366":{"type":"liquid","settings":{"liquid":"<div class=\"essential-upsell-cross-sell-block\"><\/div>"}},"kiwi_size_chart_recommender_kiwi_sizing_zVwWrC":{"type":"shopify:\/\/apps\/kiwi-size-chart-recommender\/blocks\/kiwiSizing\/b7369922-bf15-44ce-a121-a22a8fcbc4b0","settings":{"fallbackToBlockPosition":false,"waitForElementSelector":"","waitForElementDelay":5}},"liquid_papGaB":{"type":"liquid","settings":{"liquid":"<!-- Back to Top Button -->\n<a href=\"#top\" class=\"back-to-top\" id=\"backToTop\" aria-label=\"Back to top\">\n  <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/arrow-up-svgrepo-com.svg?v=1743044799\" alt=\"Back to top\">\n<\/a>\n\n<style>\n.back-to-top {\n  position: fixed;\n  bottom: 90px; \/* keeps it above sticky ATC *\/\n  right: 16px;\n  width: 36px;\n  height: 36px;\n  background-color: #f5f5f5;\n  border-radius: 999px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.15);\n  display: none;\n  jus