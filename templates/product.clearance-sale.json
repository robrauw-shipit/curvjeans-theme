n    text-decoration: underline;\n  }\n\n  \/* MOBILE *\/\n  @media (max-width: 600px) {\n    .free-shipping-banner .content {\n      font-size: 13px;\n      gap: 6px;\n    }\n    .flag {\n      font-size: 16px;\n    }\n  }\n<\/style>"}},"liquid_BMjtFi":{"type":"liquid","settings":{"liquid":"{% render 'clearance-noreturns-pdp' %}"}},"liquid_Y36yzd":{"type":"liquid","disabled":true,"settings":{"liquid":"{% assign is_nl = false %}\n{% assign is_de = false %}\n\n{% if request.path contains '\/nl' or localization.language.iso_code == 'nl' %}\n  {% assign is_nl = true %}\n{% elsif request.path contains '\/de' or localization.language.iso_code == 'de' %}\n  {% assign is_de = true %}\n{% endif %}\n\n<div class=\"cj-video-section\">\n\n  <div class=\"cj-video-title\">\n    {% if is_nl %}\n      Meer dan <strong>10.000 vrouwen<\/strong> vonden eindelijk jeans die écht passen.\n    {% elsif is_de %}\n      Über <strong>10.000 Frauen<\/strong> haben ihre perfekte Jeans gefunden.\n    {% else %}\n      Join <strong>10,000+ women<\/strong> who finally <br>found jeans that fit\n    {% endif %}\n  <\/div>\n\n  <div id=\"ss-product-video-4\"><\/div>\n\n<\/div>\n\n<style>\n  \/* Wrapper for whole video section *\/\n  .cj-video-section {\n    margin-bottom: 36px;\n  }\n\n  .cj-video-title {\n    text-align: center;\n    font-size: 20px;\n    font-weight: 700;\n    color: #111;\n    margin: 1px 0 18px;\n    line-height: 1.3;\n    padding: 0 12px;\n  }\n\n  .cj-video-title strong {\n    font-weight: 800;\n  }\n\n  @media (max-width: 600px) {\n    .cj-video-title {\n      font-size: 18px;\n      margin: 22px 0 22px;\n    }\n  }\n<\/style>"}},"liquid_UYTTHe":{"type":"liquid","settings":{"liquid":"{% render 'cj-stretchiness-row', product: product %}"}},"collapsible_text_7KYfLw":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Description","content":"{{ product.description }}","page":""}},"collapsible_text_rcQ8QH":{"type":"collapsible_text","disabled":true,"settings":{"icon":"none","icon_width":20,"title":"Size & Perfect-Fit Guarantee","content":"<p>Not sure which size suits your shape? Tap <strong>“Find my true size”<\/strong> under the size picker to take our 15-second Fit Quiz. Or just check the full size guide beside it, just measure your waist in cm\/inch and match it to your size.<\/p><p><strong>Perfect-Fit Guarantee<\/strong><br\/>Order your best-guess size with confidence. If the fit isn’t quite right, you can make a free exchange through our returnportal.<\/p>","page":""}},"collapsible_text_XtCTEg":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"Shipping & Exchanges","content":"<p>Orders are delivered in <strong>3–6 business days<\/strong> (excluding pre-orders) with track & trace. Free shipping on all orders.<\/p><p><strong>Exchanges<\/strong><br\/>Exchanges are always free. If the fit isn’t quite right, you can swap sizes at no cost through our return portal.<\/p><p><strong>Returns<\/strong><br\/>Refunds are available within 14 days. Return labels are purchased directly in the portal before you confirm. Items must be in original condition. See full Returns Policy.<\/p>","page":""}},"collapsible_text_HUDbb7":{"type":"collapsible_text","settings":{"icon":"none","icon_width":20,"title":"FAQ","content":"<p><strong>How do I measure my waist?<\/strong><br\/>Use a measuring tape and measure around the smallest part of your waist — usually near your belly button.<br\/><br\/><strong>How do I know CURVJEANS will fit?<br\/><\/strong>Check our <a href=\"https:\/\/curvjeans.com\/pages\/size-guide\" target=\"_blank\" title=\"Size Guide\">size guide <\/a>with real measurements and do our fit quiz or simply DM us! Still unsure? Exchanges are completely free.<br\/><br\/><strong>How long are the jeans?<br\/><\/strong>Length depends on your legs! We list inseam options in our size guide. Still unsure? Shoot us an email and we’ll help you out.<br\/><br\/><strong>I wear this size in other brands, can I choose the same for CURVJEANS?<\/strong><br\/>Sizing varies by brand, so we always recommend measuring your waist and checking our size guide. Need help? Just message us!<br\/><br\/><strong>Will my jeans stretch out after wearing them?<\/strong><br\/>Nope! Our premium stretchy fabric keeps its shape. Want to make them last even longer? Check our Denim Care Guide.<br\/><strong><br\/>What’s your return policy?<br\/><\/strong>30 days hassle-free returns. <a href=\"https:\/\/curvjeans.com\/policies\/refund-policy\" target=\"_blank\" title=\"https:\/\/curvjeans.com\/policies\/refund-policy\">Full details here.<\/a><br\/><\/p>","page":""}},"associated_products_Dtwt4c":{"type":"associated_products","settings":{"title":"Add Shapewear for a Smoother Fit","stack_products":false,"products_count":3,"background":"#f9f9f9","text_color":""}}},"block_order":["badges","title","text_6xBch3","loox_reviews_loox_rating_RAJ6Ck","liquid_trHECm","linkedoption_combined_listings_app_block_r9FxMn","fit_quiz_for_clothes_and_shoes_fitquiz_block_VEFLPN","kiwi_size_chart_recommender_kiwi_sizing_zVwWrC","liquid_XyW7P7","variant_picker","liquid_KYQgrq","liquid_aAUrf8","buy_buttons","liquid_DHpMmG","liquid_BMjtFi","liquid_Y36yzd","liquid_UYTTHe","collapsible_text_7KYfLw","collapsible_text_rcQ8QH","collapsible_text_XtCTEg","collapsible_text_HUDbb7","associated_products_Dtwt4c"],"custom_css":[".product-info__block-item {margin-top: 6px; margin-bottom: 6px;}",".product-info {margin-top: -10px !important;}",".product-info__text {font-size: var(--text-base-size);}",".product-info__title.h5 {margin-top: 0px;}","@media (max-width: 768px) {.product__media {position: relative; } .product-info__badge-list {position: absolute; top: 10px; left: 10px; z-index: 1; } .product {margin-bottom: -30px; }}",".product-gallery__ar-wrapper {margin-top: -10px;}",".product-usps {margin-bottom: 15px !important;}"],"settings":{"full_width":false,"show_fixed_add_to_cart":true,"desktop_media_width":50,"desktop_media_layout":"c