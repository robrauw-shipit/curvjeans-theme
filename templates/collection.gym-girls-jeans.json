    <p class=\"testimonial-author\">— Mayte<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>\n\n<script>\n  if (window.location.pathname.includes('\/nl')) {\n    \/\/ Swap Header\n    const headerH2 = document.querySelector('.curvjeans-social-proof .section-header h2');\n    const headerP  = document.querySelector('.curvjeans-social-proof .section-header p');\n    headerH2.textContent = 'Duizenden girls gingen je al voor';\n    headerP.textContent  = 'en de reviews liegen er niet om.';\n\n    \/\/ Swap Reviews\n    const nlQuotes = [\n      '“Ik heb serieus 10 minuten voor de spiegel gestaan om m’n billen te checken 😂 Deze jeans liften echt op de juiste plekken. Ik koop niks anders meer.”',\n      '“Ik mijd normaal altijd wide leg jeans omdat ze me zo boxy laten lijken. Maar deze? Snatched taille en een mooie booty. Echt bizar.”',\n      '“Bij elk ander merk zeggen ze ‘stretchy’, maar alsnog snijdt het in m’n taille. Deze zijn anders. De stof vormt zich echt naar je lichaam.”'\n    ];\n\n    document.querySelectorAll('.testimonial-quote').forEach((el, i) => {\n      if (nlQuotes[i]) el.textContent = nlQuotes[i];\n    });\n  }\n<\/script>","background":"#f7f7f7","background_gradient":"","text_color":""}},"banner":{"type":"collection-banner","disabled":true,"custom_css":[".collection-header {margin-top: 10px !important; margin-bottom: 20px !important;}"],"settings":{"full_width":true,"allow_transparent_header":false,"enable_parallax":false,"show_collection_title":false,"show_collection_description":false,"show_collection_image":true,"collection_title_size":"h4","image_size":"auto","image":"shopify:\/\/shop_images\/SUMMER_SALE_EN_DESKTOP.jpg","mobile_image":"shopify:\/\/shop_images\/buy_2_save_20_v1.jpg","mobile_text_position":"place-self-center-end text-end","desktop_text_position":"sm:place-self-center sm:text-center","featured_product":"","featured_product_heading":"Featured product","text_color":"#ffffff","overlay_color":"#000000","overlay_opacity":0}},"cus