bnav__link {% if request.path contains '\/collections\/all-products' %}is-active{% endif %}\" href=\"https:\/\/curvjeans.com\/collections\/all-products\">All<\/a>\n\n    <a class=\"cj-collection-subnav__link {% if request.path contains '\/collections\/new' %}is-active{% endif %}\" href=\"https:\/\/curvjeans.com\/collections\/new\">New<\/a>\n\n    <a class=\"cj-collection-subnav__link {% if request.path contains '\/collections\/bestsellers' %}is-active{% endif %}\" href=\"https:\/\/curvjeans.com\/collections\/bestsellers\">Bestsellers<\/a>\n\n    <a class=\"cj-collection-subnav__link {% if request.path contains '\/collections\/high-waist' %}is-active{% endif %}\" href=\"https:\/\/curvjeans.com\/collections\/high-waist\">High Waist<\/a>\n\n    <a class=\"cj-collection-subnav__link {% if request.path contains '\/collections\/mid-rise' %}is-active{% endif %}\" href=\"https:\/\/curvjeans.com\/collections\/mid-rise\">Mid Rise<\/a>\n\n    <a class=\"cj-collection-subnav__link {% if request.path contains '\/collections\/tall' %}is-active{% endif %}\" href=\"https:\/\/curvjeans.com\/collections\/tall\">Tall<\/a>\n\n    <a class=\"cj-collection-subnav__link {% if request.path contains '\/collections\/sale' %}is-active{% endif %}\" href=\"https:\/\/curvjeans.com\/collections\/sale\">Sale<\/a>\n  <\/div>\n<\/nav>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const nav = document.querySelector('.cj-collection-subnav');\n    if (!nav) return;\n\n    const replaceSelectors = [\n      '#ProductGridContainer',\n      '.collection',\n      '.main-collection-product-grid',\n      '[data-product-grid]'\n    ];\n\n    function getReplaceTarget(doc = document) {\n      for (const selector of replaceSelectors) {\n        const el = doc.querySelector(selector);\n        if (el) return { selector, el };\n      }\n      return null;\n    }\n\n    function setActiveLink(url) {\n      const targetPath = new URL(url, window.location.origin).pathname;\n\n      nav.querySelectorAll('.cj-collection-subnav__link').forEach(link => {\n        const linkPath = new URL(link.href, window.location.origin).pathname;\n        link.classList.toggle('is-active', linkPath === targetPath);\n      });\n    }\n\n    async function swapCollection(url, push = true) {\n      const current = getReplaceTarget(document);\n\n      if (!current) {\n        window.location.href = url;\n        return;\n      }\n\n      document.documentElement.classList.add('cj-collection-loading');\n      current.el.style.opacity = '0.35';\n      current.el.style.pointerEvents = 'none';\n\n      try {\n        const response = await fetch(url, {\n          headers: { 'X-Requested-With': 'XMLHttpRequest' }\n        });\n\n        const html = await response.text();\n        const nextDoc = new DOMParser().parseFromString(html, 'text\/html');\n        const next = getReplaceTarget(nextDoc);\n\n        if (!next) {\n          window.location.href = url;\n          return;\n        }\n\n        current.el.replaceWith(next.el);\n\n        if (push) {\n          history.pushState({ cjCollectionUrl: url }, '', url);\n        }\n\n        setActiveLink(url);\n      } catch (error) {\n        window.location.href = url;\n      } finally {\n        document.documentElement.classList.remove('cj-collection-loading');\n\n        const refreshed = getReplaceTarget(document);\n        if (refreshed) {\n          refreshed.el.style.opacity = '';\n          refreshed.el.style.pointerEvents = '';\n        }\n      }\n    }\n\n    nav.addEventListener('click', function (event) {\n      const link = event.target.closest('a.cj-collection-subnav__link');\n      if (!link) return;\n\n      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;\n\n      event.preventDefault();\n      swapCollection(link.href, true);\n    });\n\n    window.addEventListener('popstate', function () {\n      swapCollection(window.location.href, false);\n    });\n\n    setActiveLink(window.location.href);\n  });\n<\/script>\n\n<style>\n  .cj-collection-loading {\n    cursor: progress;\n  }\n<\/style>","background":"","background_gradient":"","text_color":""}},"custom_liquid_W63qiP":{"type":"custom-liquid","name":"Custom Liquid","settings":{"full_width":true,"remove_vertical_spacing":true,"remove_horizontal_spacing":true,"liquid":"{%- comment -%}\nCURVJEANS — Social Proof Trust Strip\n{%- endcomment -%}\n\n{%- liquid\n  assign _lc = request.locale.iso_code | downcase\n\n  case _lc\n    when \"nl\"\n      assign spt = \"Geliefd door <strong>20.000+<\/strong> vrouwen\"\n    when \"de\"\n      assign spt = \"Geliebt von <strong>20.000+<\/strong> Frauen\"\n    else\n      assign spt = \"Worn & Loved by <strong>20,000+<\/strong> women\"\n  endcase\n-%}\n\n<div class=\"cj-spb-section\">\n  <div class=\"cj-spb-wrapper\">\n    <span class=\"cj-spb-text\">{{ spt }}<\/span>\n    <img\n      class=\"cj-spb-verified\"\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/verified.webp?v=1726649878\"\n      alt=\"\"\n      loading=\"lazy\"\n    >\n  <\/div>\n<\/div>\n\n<style>\n  .cj-spb-section {\n    background: #fff;\n    border-bottom: 1px solid #eeeeee;\n  }\n\n  .cj-spb-wrapper {\n    min-height: 44px;\n    padding: 10px 16px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 6px;\n    text-align: center;\n    color: #5f5f5f;\n    font: inherit;\n    font-size: 13.5px;\n    font-weight: 500;\n    line-height: 1.25;\n  }\n\n  .cj-spb-wrapper strong {\n    color: #222;\n    font-weight: 700;\n  }\n\n  .cj-spb-verified {\n    width: 15px;\n    height: 15px;\n    display: block;\n    flex: 0 0 auto;\n  }\n\n  @media (min-width: 768px) {\n    .cj-spb-wrapper {\n      min-height: 48px;\n      padding: 11px 20px;\n      font-size: 14px;\n    }\n  }\n<\/style>","background":"","background_gradient":"","text_color":""}},"banner":{"type":"collection-banner","disabled":true,"custom_css":[".collection-header