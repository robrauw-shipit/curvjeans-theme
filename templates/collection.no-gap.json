    "ng_hero": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap');\n.cj-ng{--cream:#fffdf9;--cream-2:#f7efe5;--ink:#1a1a1a;--ink-70:rgba(26,26,26,.7);--terra:#b5483e;--line:rgba(26,26,26,.12);--radius:.75rem;--head:'Montserrat',sans-serif;--body:'Figtree',sans-serif;font-family:var(--body);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}\n.cj-ng *{box-sizing:border-box}\n.cj-ng .wrap{max-width:1200px;margin:0 auto;padding:0 20px}\n.cj-ng h1,.cj-ng h2,.cj-ng h3{font-family:var(--head);font-weight:800;letter-spacing:-.01em;line-height:1.05;margin:0}\n.cj-ng p{margin:0}\n.cj-ng a{color:inherit;text-decoration:none}\n.cj-ng img{display:block;max-width:100%}\n.cj-ng .btn{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--head);font-weight:700;font-size:.95rem;padding:.95rem 1.6rem;border-radius:var(--radius);border:1.5px solid var(--ink);cursor:pointer;transition:.15s}\n.cj-ng .btn-primary{background:var(--ink);color:#fff}\n.cj-ng .btn-primary:hover{opacity:.88}\n.cj-ng .btn-ghost{background:transparent;color:var(--ink)}\n.cj-ng .btn-ghost:hover{background:rgba(26,26,26,.05)}\n.cj-ng .eyebrow{font-family:var(--head);font-weight:700;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--terra)}\n.cj-ng .sec-head{text-align:center;margin-bottom:30px}\n.cj-ng .sec-head h2{font-size:clamp(1.5rem,3vw,2.1rem)}\n.cj-ng .sec-head p{color:var(--ink-70);margin-top:.5rem}\n/* hero */\n.cj-ng-hero{background:linear-gradient(180deg,var(--cream-2),var(--cream));overflow:hidden}\n.cj-ng-hero .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;padding:54px 0 48px}\n.cj-ng-hero h1{font-size:clamp(2.2rem,4.6vw,3.5rem)}\n.cj-ng-hero h1 em{font-style:normal;color:var(--terra)}\n.cj-ng-hero .sub{font-size:1.12rem;color:var(--ink-70);margin:1.1rem 0 .4rem;max-width:34ch}\n.cj-ng-hero .ratio{font-family:var(--head);font-weight:700;font-size:.9rem;margin-top:.5rem}\n.cj-ng-hero .feat{list-style:none;margin:1.4rem 0 1.6rem;padding:0;display:flex;flex-direction:column;gap:.55rem}\n.cj-ng-hero .feat li{display:flex;align-items:center;gap:.6rem;font-weight:500;font-size:1rem}\n.cj-ng-hero .feat svg{flex:none}\n.cj-ng-hero .hero-cta{display:flex;gap:.8rem;flex-wrap:wrap;align-items:center}\n.cj-ng-hero .sizes{font-size:.85rem;color:var(--ink-70);margin-top:.9rem;font-weight:500}\n.cj-ng-hero .hero-media{position:relative}\n.cj-ng-hero .hero-media img{width:100%;height:540px;object-fit:cover;border-radius:18px}\n.cj-ng-hero .hero-badge{position:absolute;left:18px;bottom:18px;background:#fff;border-radius:14px;padding:.7rem .9rem;box-shadow:0 10px 30px rgba(26,26,26,.14);display:flex;align-items:center;gap:.6rem;max-width:240px}\n.cj-ng-hero .hero-badge .stars{color:var(--terra);font-size:.8rem;letter-spacing:1px}\n.cj-ng-hero .hero-badge .q{font-size:.82rem;font-weight:500;line-height:1.25}\n@media(max-width:820px){.cj-ng-hero .hero-grid{grid-template-columns:1fr;padding:34px 0}.cj-ng-hero .hero-media img{height:380px}}\n/* trust */\n.cj-ng-trust{background:var(--ink);color:#fff}\n.cj-ng-trust .wrap{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:.8rem 20px;font-family:var(--head);font-weight:600;font-size:.78rem;letter-spacing:.04em;text-transform:uppercase}\n.cj-ng-trust .t{display:flex;align-items:center;gap:.5rem;opacity:.95}\n.cj-ng-trust .t b{color:#ffd9b0;font-weight:700}\n/* shop by problem */\n.cj-ng-sec{padding:56px 0}\n.cj-ng-probs{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.cj-ng-probs .prob{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:3/4;background:var(--cream-2)}\n.cj-ng-probs .prob img{width:100%;height:100%;object-fit:cover;transition:.3s}\n.cj-ng-probs .prob:hover img{transform:scale(1.04)}\n.cj-ng-probs .lbl{position:absolute;inset:auto 0 0 0;padding:16px;background:linear-gradient(180deg,transparent,rgba(26,26,26,.82));color:#fff;font-family:var(--head);font-weight:700}\n.cj-ng-probs .lbl small{display:block;font-weight:500;font-size:.78rem;opacity:.85;margin-top:2px;font-family:var(--body)}\n@media(max-width:820px){.cj-ng-probs{grid-template-columns:repeat(2,1fr)}}\n/* why */\n.cj-ng-why{background:var(--cream-2);padding:56px 0}\n.cj-ng-why .why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:8px}\n.cj-ng-why .why-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:26px}\n.cj-ng-why .why-card .ic{width:46px;height:46px;border-radius:50%;background:var(--cream-2);display:grid;place-items:center;margin-bottom:14px;font-size:1.3rem}\n.cj-ng-why .why-card h3{font-size:1.05rem;margin-bottom:.4rem}\n.cj-ng-why .why-card p{color:var(--ink-70);font-size:.95rem}\n@media(max-width:820px){.cj-ng-why .why-grid{grid-template-columns:1fr}}\n/* reviews */\n.cj-ng-reviews{background:var(--ink);color:#fff;padding:56px 0}\n.cj-ng-reviews .sec-head h2,.cj-ng-reviews .sec-head p{color:#fff}\n.cj-ng-reviews .rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:10px}\n.cj-ng-reviews .rev-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:24px}\n.cj-ng-reviews .rev-card .stars{color:#ffd9b0;letter-spacing:2px;margin-bottom:.7rem}\n.cj-ng-reviews .rev-card blockquote{font-size:1.02rem;line-height:1.45;margin:0}\n.cj-ng-reviews .rev-card .who{margin-top:.9rem;font-size:.82rem;opacity:.75;font-family:var(--head);font-weight:600;letter-spacing:.03em}\n@media(max-width:820px){.cj-ng-reviews .rev-grid{grid-template-columns:1fr}}\n</style>\n\n<div class=\"cj-ng cj-ng-hero\">\n  <div class=\"wrap hero-grid\">\n    <div class=\"hero-copy\">\n      <div class=\"eyebrow\">For a small waist &amp; fuller hips</div>\n      <h1>Jeans that fit your hips <em>and</em> your waist.</h1>\n      <p class=\"sub\">No gap. No belt. No sizing up. Finally one pair that fits both — instead of the trade-off.</p>\n      <p class=\"ratio\">Engineered for a 10″+ hip-to-waist difference — sits flat at the back, even when you sit down.</p>\n      <ul class=\"feat\">\n        <li><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#b5483e\"/><path d=\"M7 12.5l3 3 7-7\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> No-gap ContourFit™ waistband</li>\n        <li><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#b5483e\"/><path d=\"M7 12.5l3 3 7-7\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> 4-way stretch that holds its shape all day</li>\n        <li><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#b5483e\"/><path d=\"M7 12.5l3 3 7-7\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg> Free exchanges until they fit</li>\n      </ul>\n      <div class=\"hero-cta\">\n        <a class=\"btn btn-primary\" href=\"#cj-ng-grid\">Shop the no-gap fit</a>\n        <a class=\"btn btn-ghost\" href=\"/pages/fit-quiz\">Take the 30-sec fit quiz</a>\n      </div>\n      <p class=\"sizes\">Sizes US 0–24 · Petite, Regular &amp; Tall lengths</p>\n    </div>\n    <div class=\"hero-media\">\n      <img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=1000\" alt=\"Model wearing CurvJeans wide-leg, flat at the waist\" loading=\"eager\">\n      <div class=\"hero-badge\">\n        <span class=\"stars\">★★★★★</span>\n        <span class=\"q\">“Fits PERFECT over my hips and waist. <b>No belt. At all.</b>”</span>\n      </div>\n    </div>\n  </div>\n</div>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
