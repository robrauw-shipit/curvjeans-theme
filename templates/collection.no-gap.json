    "ng_reviews": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-reviews\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">Real fits, real bodies</div>\n      <h2>From women shaped like you</h2>\n      <p>The reviews that matter: the ones that tell you their measurements.</p>\n    </div>\n    <div class=\"rev-grid\">\n      <div class=\"rev-card\"><span class=\"stars\">★★★★★</span>\n        <blockquote>“I’m a 16 in the hips and a 12 in the waist. These fit PERFECT over both — and no belt, at all.”</blockquote>\n        <div class=\"who\">— Size L · 5'5\" · hourglass</div></div>\n      <div class=\"rev-card\"><span class=\"stars\">★★★★★</span>\n        <blockquote>“Stretchy but they actually hold their shape. Didn’t need to change out of them by 5pm.”</blockquote>\n        <div class=\"who\">— Size 14 · curvy hips &amp; thighs</div></div>\n      <div class=\"rev-card\"><span class=\"stars\">★★★★★</span>\n        <blockquote>“Every other pair gaps at my back. First jeans that sit flat when I sit down. Bought two more.”</blockquote>\n        <div class=\"who\">— Size 18 · small waist, full seat</div></div>\n    </div>\n    <div style=\"text-align:center;margin-top:30px\">\n      <a class=\"btn btn-primary\" href=\"#cj-ng-grid\">Shop the no-gap fit →</a>\n    </div>\n  </div>\n</section>\n",
