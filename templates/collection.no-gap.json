{
  "sections": {
    "ng_hero": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<style>\n.cj-ng{--ink:#111;--ink-2:#333;--ink-3:#444;--panel:#f7f7f7;--accent:#e48175;--line:rgba(17,17,17,.12);--radius:.75rem;font-family:inherit;color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}\n.cj-ng *{box-sizing:border-box}\n.cj-ng .wrap{max-width:1200px;margin:0 auto;padding:0 24px}\n.cj-ng h1,.cj-ng h2,.cj-ng h3{font-family:inherit;font-weight:700;line-height:1.2;margin:0;color:var(--ink)}\n.cj-ng p{margin:0}\n.cj-ng a{color:inherit;text-decoration:none}\n.cj-ng img{display:block;max-width:100%}\n.cj-ng .ic-svg{flex:none}\n.cj-ng .stars{color:var(--accent);letter-spacing:1px;line-height:1}\n.cj-ng .btn{display:inline-flex;align-items:center;gap:.5rem;font-family:inherit;font-weight:700;font-size:.95rem;padding:.9rem 1.6rem;border-radius:var(--radius);border:1.5px solid var(--ink);cursor:pointer;transition:.15s}\n.cj-ng .btn-primary{background:var(--ink);color:#fff}\n.cj-ng .btn-primary:hover{opacity:.88}\n.cj-ng .btn-ghost{background:transparent;color:var(--ink)}\n.cj-ng .btn-ghost:hover{background:rgba(17,17,17,.05)}\n.cj-ng .eyebrow{font-family:inherit;font-weight:700;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-3)}\n.cj-ng .sec-head{text-align:center;margin-bottom:30px}\n.cj-ng .sec-head h2{font-size:clamp(1.4rem,3vw,2rem)}\n.cj-ng .sec-head p{color:var(--ink-3);margin-top:.5rem}\n/* hero */\n.cj-ng-hero{background:#fff}\n.cj-ng-hero .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center;padding:32px 24px;max-width:1200px;margin:0 auto}\n.cj-ng-hero h1{font-size:clamp(1.6rem,3.4vw,2.4rem);color:var(--ink)}\n.cj-ng-hero h1 em{font-style:italic}\n.cj-ng-hero .sub{font-size:1.05rem;color:var(--ink-3);margin:1rem 0 .4rem;max-width:36ch}\n.cj-ng-hero .ratio{font-family:inherit;font-weight:600;font-size:.9rem;margin-top:.5rem;color:var(--ink-2)}\n.cj-ng-hero .feat{list-style:none;margin:1.3rem 0 1.5rem;padding:0;display:flex;flex-direction:column;gap:.55rem}\n.cj-ng-hero .feat li{display:flex;align-items:center;gap:.6rem;font-weight:500;font-size:1rem;color:var(--ink-2)}\n.cj-ng-hero .feat .ic-svg{color:var(--ink)}\n.cj-ng-hero .hero-cta{display:flex;gap:.8rem;flex-wrap:wrap;align-items:center}\n.cj-ng-hero .sizes{font-size:.85rem;color:var(--ink-3);margin-top:.9rem}\n.cj-ng-hero .hero-media{position:relative}\n.cj-ng-hero .hero-media img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:14px}\n.cj-ng-hero .hero-badge{position:absolute;left:16px;bottom:16px;background:#fff;border-radius:12px;padding:.7rem .9rem;box-shadow:0 8px 26px rgba(17,17,17,.14);display:flex;align-items:center;gap:.6rem;max-width:240px}\n.cj-ng-hero .hero-badge .q{font-size:.82rem;font-weight:500;line-height:1.25;color:var(--ink-2)}\n@media(max-width:768px){.cj-ng-hero .hero-grid{grid-template-columns:1fr;padding:16px;gap:16px}}\n/* trust (light) */\n.cj-ng-trust{background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.cj-ng-trust .wrap{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:.9rem 24px;font-family:inherit;font-weight:600;font-size:.8rem;color:var(--ink-2)}\n.cj-ng-trust .t{display:flex;align-items:center;gap:.5rem}\n.cj-ng-trust .t .ic-svg{width:16px;height:16px;color:var(--ink)}\n.cj-ng-trust .t b{font-weight:700;color:var(--ink)}\n/* shop by problem */\n.cj-ng-sec{padding:52px 0}\n.cj-ng-probs{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}\n.cj-ng-probs .prob{position:relative;border-radius:14px;overflow:hidden;aspect-ratio:3/4;background:var(--panel)}\n.cj-ng-probs .prob img{width:100%;height:100%;object-fit:cover;transition:.3s}\n.cj-ng-probs .prob:hover img{transform:scale(1.04)}\n.cj-ng-probs .lbl{position:absolute;inset:auto 0 0 0;padding:16px;background:linear-gradient(180deg,transparent,rgba(17,17,17,.82));color:#fff;font-family:inherit;font-weight:700}\n.cj-ng-probs .lbl{color:#fff}\n.cj-ng-probs .lbl small{display:block;font-weight:500;font-size:.78rem;opacity:.9;margin-top:2px}\n@media(max-width:768px){.cj-ng-probs{grid-template-columns:repeat(2,1fr)}}\n/* why (panel) */\n.cj-ng-why{background:var(--panel);padding:52px 0}\n.cj-ng-why .why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:8px}\n.cj-ng-why .why-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:26px}\n.cj-ng-why .why-card .ic{width:46px;height:46px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;margin-bottom:14px}\n.cj-ng-why .why-card .ic .ic-svg{width:22px;height:22px}\n.cj-ng-why .why-card h3{font-size:1.05rem;margin-bottom:.4rem}\n.cj-ng-why .why-card p{color:var(--ink-3);font-size:.95rem}\n@media(max-width:768px){.cj-ng-why .why-grid{grid-template-columns:1fr}}\n/* reviews (light) */\n.cj-ng-reviews{background:#fff;padding:52px 0}\n.cj-ng-reviews .rev-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:10px}\n.cj-ng-reviews .rev-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px}\n.cj-ng-reviews .rev-card .stars{display:block;margin-bottom:.7rem;font-size:1rem}\n.cj-ng-reviews .rev-card blockquote{font-size:1rem;line-height:1.45;margin:0;color:var(--ink-2)}\n.cj-ng-reviews .rev-card .who{margin-top:.9rem;font-size:.82rem;color:var(--ink-3);font-family:inherit;font-weight:600}\n@media(max-width:768px){.cj-ng-reviews .rev-grid{grid-template-columns:1fr}}\n</style>\n\n<div class=\"cj-ng cj-ng-hero\">\n  <div class=\"hero-grid\">\n    <div class=\"hero-copy\">\n      <div class=\"eyebrow\">For a small waist &amp; fuller hips</div>\n      <h1>Jeans that fit your hips <em>and</em> your waist.</h1>\n      <p class=\"sub\">No gap. No belt. No sizing up. Finally one pair that fits both — instead of the trade-off.</p>\n      <p class=\"ratio\">Engineered for a 10″+ hip-to-waist difference — sits flat at the back, even when you sit down.</p>\n      <ul class=\"feat\">\n        <li><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12.5l5 5 11-11\"/></svg> No-gap ContourFit™ waistband</li>\n        <li><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12.5l5 5 11-11\"/></svg> 4-way stretch that holds its shape all day</li>\n        <li><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12.5l5 5 11-11\"/></svg> Free exchanges until they fit</li>\n      </ul>\n      <div class=\"hero-cta\">\n        <a class=\"btn btn-primary\" href=\"#cj-ng-grid\">Shop the no-gap fit</a>\n        <a class=\"btn btn-ghost\" href=\"/pages/fit-quiz\">Take the 30-sec fit quiz</a>\n      </div>\n      <p class=\"sizes\">Sizes US 0–24 · Petite, Regular &amp; Tall lengths</p>\n    </div>\n    <div class=\"hero-media\">\n      <img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=1000\" alt=\"Model wearing CurvJeans wide-leg, flat at the waist\" loading=\"eager\">\n      <div class=\"hero-badge\">\n        <span class=\"stars\">★★★★★</span>\n        <span class=\"q\">“Fits PERFECT over my hips and waist. <b>No belt. At all.</b>”</span>\n      </div>\n    </div>\n  </div>\n</div>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
