    "ng_probs": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-sec\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">Find your fit fast</div>\n      <h2>Shop by your fit problem</h2>\n      <p>Tell us where regular jeans fail you — we’ll point you straight to the cut that fixes it.</p>\n    </div>\n    <div class=\"cj-ng-probs\">\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_dd945a50-d4cf-4769-b11a-48db9c6c18f0.jpg?v=1781166162&width=600\" alt=\"Small waist, full hips\"><span class=\"lbl\">Small waist, full hips<small>Closes the waist gap</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/MidRise-Black11.jpg?v=1780213356&width=600\" alt=\"Tummy smoothing\"><span class=\"lbl\">Tummy smoothing<small>High-rise hold, no muffin top</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Model1-StraightBlack1.jpg?v=1777822432&width=600\" alt=\"Room for hips and seat\"><span class=\"lbl\">Room for hips &amp; seat<small>Fits thighs without a loose waist</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=600\" alt=\"Tall length\"><span class=\"lbl\">Tall length<small>Long enough, finally</small></span></a>\n    </div>\n  </div>\n</section>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "ng_why": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-why\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">The fix</div>\n      <h2>Why CurvJeans don’t gap</h2>\n      <p>Every pair forces a trade-off. Here’s the engineering that ends it.</p>\n    </div>\n    <div class=\"why-grid\">\n      <div class=\"why-card\">\n        <div class=\"ic\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12h18\"/><path d=\"M7 8c2 2.5 8 2.5 10 0\"/><path d=\"M7 16c2-2.5 8-2.5 10 0\"/></svg></div>\n        <h3>No-gap ContourFit™ waistband</h3>\n        <p>A contoured, structural waistband — not an add-on insert — that sits flat against your back instead of standing away from it. No more “reverse kangaroo pouch.”</p>\n      </div>\n      <div class=\"why-card\">\n        <div class=\"ic\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 12h20\"/><path d=\"M6 8l-4 4 4 4\"/><path d=\"M18 8l4 4-4 4\"/></svg></div>\n        <h3>4-way stretch that recovers</h3>\n        <p>Moves with your hips and thighs, then snaps back. It holds its shape all day — it won’t bag out or sag by 5pm like cheap stretch denim.</p>\n      </div>\n      <div class=\"why-card\">\n        <div class=\"ic\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4c0 6 3 10 7 10s7-4 7-10\"/><path d=\"M5 20c0-4 3-6 7-6s7 2 7 6\"/></svg></div>\n        <h3>Cut for curves, not sized up</h3>\n        <p>Room built in through the hip, thigh and seat — so you fit both ends at once and skip the size-up compromise that never looks good.</p>\n      </div>\n    </div>\n  </div>\n</section>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
