        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-sec\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">Find your fit fast</div>\n      <h2>Shop by your fit problem</h2>\n      <p>Tell us where regular jeans fail you — we’ll point you straight to the cut that fixes it.</p>\n    </div>\n    <div class=\"cj-ng-probs\">\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_dd945a50-d4cf-4769-b11a-48db9c6c18f0.jpg?v=1781166162&width=600\" alt=\"Small waist, full hips\"><span class=\"lbl\">Small waist, full hips<small>Closes the waist gap</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/MidRise-Black11.jpg?v=1780213356&width=600\" alt=\"Tummy smoothing\"><span class=\"lbl\">Tummy smoothing<small>High-rise hold, no muffin top</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Model1-StraightBlack1.jpg?v=1777822432&width=600\" alt=\"Room for hips and seat\"><span class=\"lbl\">Room for hips &amp; seat<small>Fits thighs without a loose waist</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=600\" alt=\"Tall length\"><span class=\"lbl\">Tall length<small>Long enough, finally</small></span></a>\n    </div>\n  </div>\n</section>\n",
