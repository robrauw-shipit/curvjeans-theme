    "ng_why": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-why\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">The fix</div>\n      <h2>Why CurvJeans don’t gap</h2>\n      <p>Every pair forces a trade-off. Here’s the engineering that ends it.</p>\n    </div>\n    <div class=\"why-grid\">\n      <div class=\"why-card\">\n        <div class=\"ic\">🩹</div>\n        <h3>No-gap ContourFit™ waistband</h3>\n        <p>A contoured, structural waistband — not an add-on insert — that sits flat against your back instead of standing away from it. No more “reverse kangaroo pouch.”</p>\n      </div>\n      <div class=\"why-card\">\n        <div class=\"ic\">↔️</div>\n        <h3>4-way stretch that recovers</h3>\n        <p>Moves with your hips and thighs, then snaps back. It holds its shape all day — it won’t bag out or sag by 5pm like cheap stretch denim.</p>\n      </div>\n      <div class=\"why-card\">\n        <div class=\"ic\">🍑</div>\n        <h3>Cut for curves, not sized up</h3>\n        <p>Room built in through the hip, thigh and seat — so you fit both ends at once and skip the size-up compromise that never looks good.</p>\n      </div>\n    </div>\n  </div>\n</section>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
