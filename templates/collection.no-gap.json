        "liquid": "\n<div class=\"cj-ng cj-ng-trust\">\n  <div class=\"wrap\">\n    <span class=\"t\"><span class=\"stars\">★</span> <b>4.8</b> · 20,000+ verified fits</span>\n    <span class=\"t\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12.5l5 5 11-11\"/></svg> No-gap guarantee</span>\n    <span class=\"t\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 8h13l-3-3M20 16H7l3 3\"/></svg> Free size exchanges</span>\n    <span class=\"t\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 9a8 8 0 1 1-1 4\"/><path d=\"M3 4v5h5\"/></svg> 14-day easy returns</span>\n    <span class=\"t\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 7h11v8H2zM13 10h4l3 3v2h-7z\"/><circle cx=\"6\" cy=\"17\" r=\"1.5\"/><circle cx=\"17\" cy=\"17\" r=\"1.5\"/></svg> Free shipping over $100</span>\n  </div>\n</div>\n",
