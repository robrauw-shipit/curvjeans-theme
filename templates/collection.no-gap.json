    "ng_hero": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<style>\n/* MOBILE-FIRST. Readability floor = 16px body (matches theme base). Generous spacing. */\n.cj-ng{--ink:#111;--ink-2:#2a2a2a;--ink-3:#555;--panel:#f7f7f7;--accent:#e48175;--line:rgba(17,17,17,.12);--radius:.75rem;font-family:inherit;color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}\n.cj-ng *{box-sizing:border-box}\n.cj-ng .wrap{max-width:1200px;margin:0 auto;padding:0 20px}\n.cj-ng h1,.cj-ng h2,.cj-ng h3{font-family:inherit;font-weight:700;line-height:1.22;margin:0;color:var(--ink);letter-spacing:-.01em}\n.cj-ng p{margin:0}\n.cj-ng a{color:inherit;text-decoration:none}\n.cj-ng img{display:block;max-width:100%}\n.cj-ng .ic-svg{flex:none}\n.cj-ng .stars{color:var(--accent);letter-spacing:2px;line-height:1}\n.cj-ng .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:inherit;font-weight:700;font-size:1rem;min-height:52px;padding:.95rem 1.5rem;border-radius:var(--radius);border:1.5px solid var(--ink);cursor:pointer;transition:.15s;text-align:center}\n.cj-ng .btn-primary{background:var(--ink);color:#fff}\n.cj-ng .btn-primary:hover{opacity:.88}\n.cj-ng .btn-ghost{background:transparent;color:var(--ink)}\n.cj-ng .btn-ghost:hover{background:rgba(17,17,17,.05)}\n.cj-ng .eyebrow{font-family:inherit;font-weight:700;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}\n.cj-ng .sec-head{text-align:center;margin-bottom:28px}\n.cj-ng .sec-head .eyebrow{display:block;margin-bottom:10px}\n.cj-ng .sec-head h2{font-size:1.65rem}\n.cj-ng .sec-head p{color:var(--ink-3);margin:10px auto 0;font-size:1rem;max-width:42ch}\n\n/* ---------- HERO (mobile-first: image first, then copy) ---------- */\n.cj-ng-hero{background:#fff}\n.cj-ng-hero .hero-grid{display:flex;flex-direction:column;gap:24px;padding:24px 20px 12px;max-width:1200px;margin:0 auto}\n.cj-ng-hero .hero-media{position:relative;order:1}\n.cj-ng-hero .hero-copy{order:2}\n.cj-ng-hero .hero-copy .eyebrow{display:block;margin-bottom:12px}\n.cj-ng-hero h1{font-size:2rem;line-height:1.18}\n.cj-ng-hero h1 em{font-style:italic}\n.cj-ng-hero .sub{font-size:1.0625rem;line-height:1.55;color:var(--ink-2);margin:14px 0 0}\n.cj-ng-hero .ratio{font-family:inherit;font-weight:600;font-size:.95rem;line-height:1.5;margin-top:14px;color:var(--ink-3)}\n.cj-ng-hero .feat{list-style:none;margin:20px 0 22px;padding:0;display:flex;flex-direction:column;gap:12px}\n.cj-ng-hero .feat li{display:flex;align-items:flex-start;gap:.65rem;font-weight:500;font-size:1rem;line-height:1.45;color:var(--ink-2)}\n.cj-ng-hero .feat .ic-svg{color:var(--accent);margin-top:2px;width:22px;height:22px}\n.cj-ng-hero .hero-cta{display:flex;flex-direction:column;gap:12px}\n.cj-ng-hero .hero-cta .btn{width:100%}\n.cj-ng-hero .sizes{font-size:.9rem;color:var(--ink-3);margin-top:14px;text-align:center}\n.cj-ng-hero .hero-media img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:16px}\n.cj-ng-hero .hero-badge{position:absolute;left:14px;bottom:14px;right:14px;background:#fff;border-radius:12px;padding:.8rem .9rem;box-shadow:0 8px 26px rgba(17,17,17,.16);display:flex;align-items:center;gap:.65rem}\n.cj-ng-hero .hero-badge .stars{font-size:.95rem}\n.cj-ng-hero .hero-badge .q{font-size:.9rem;font-weight:500;line-height:1.35;color:var(--ink-2)}\n\n/* ---------- TRUST (mobile: clean stacked rows) ---------- */\n.cj-ng-trust{background:var(--panel);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}\n.cj-ng-trust .wrap{display:grid;grid-template-columns:1fr 1fr;gap:14px 18px;padding:18px 20px;font-family:inherit;font-weight:600;font-size:.9rem;line-height:1.3;color:var(--ink-2)}\n.cj-ng-trust .t{display:flex;align-items:center;gap:.5rem}\n.cj-ng-trust .t:first-child{grid-column:1 / -1;justify-content:center;font-size:.95rem}\n.cj-ng-trust .t .ic-svg{width:18px;height:18px;color:var(--accent)}\n.cj-ng-trust .t b{font-weight:700;color:var(--ink)}\n\n/* ---------- SHOP BY PROBLEM (mobile: 2-col) ---------- */\n.cj-ng-sec{padding:48px 0}\n.cj-ng-probs{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}\n.cj-ng-probs .prob{position:relative;border-radius:14px;overflow:hidden;aspect-ratio:3/4;background:var(--panel)}\n.cj-ng-probs .prob img{width:100%;height:100%;object-fit:cover;transition:.3s}\n.cj-ng-probs .prob:active img{transform:scale(1.03)}\n.cj-ng-probs .lbl{position:absolute;inset:auto 0 0 0;padding:14px;background:linear-gradient(180deg,transparent,rgba(17,17,17,.85));color:#fff;font-family:inherit;font-weight:700;font-size:.95rem;line-height:1.25}\n.cj-ng-probs .lbl small{display:block;font-weight:500;font-size:.8rem;opacity:.92;margin-top:4px;line-height:1.3}\n\n/* ---------- WHY (mobile: stacked) ---------- */\n.cj-ng-why{background:var(--panel);padding:48px 0}\n.cj-ng-why .why-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:8px}\n.cj-ng-why .why-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px}\n.cj-ng-why .why-card .ic{width:48px;height:48px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;margin-bottom:14px}\n.cj-ng-why .why-card .ic .ic-svg{width:24px;height:24px}\n.cj-ng-why .why-card h3{font-size:1.15rem;line-height:1.3;margin-bottom:8px}\n.cj-ng-why .why-card p{color:var(--ink-3);font-size:1rem;line-height:1.55}\n\n/* ---------- REVIEWS (mobile: stacked) ---------- */\n.cj-ng-reviews{background:#fff;padding:48px 0}\n.cj-ng-reviews .rev-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:8px}\n.cj-ng-reviews .rev-card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:24px}\n.cj-ng-reviews .rev-card .stars{display:block;margin-bottom:12px;font-size:1.05rem}\n.cj-ng-reviews .rev-card blockquote{font-size:1.05rem;line-height:1.55;margin:0;color:var(--ink-2)}\n.cj-ng-reviews .rev-card .who{margin-top:14px;font-size:.875rem;color:var(--ink-3);font-family:inherit;font-weight:600}\n.cj-ng-reviews .rev-cta{text-align:center;margin-top:28px}\n.cj-ng-reviews .rev-cta .btn{width:100%;max-width:360px}\n\n/* ============ TABLET / DESKTOP ============ */\n@media(min-width:769px){\n  .cj-ng .wrap{padding:0 24px}\n  .cj-ng .sec-head{margin-bottom:34px}\n  .cj-ng .sec-head h2{font-size:clamp(1.6rem,2.6vw,2.1rem)}\n  .cj-ng .sec-head p{font-size:1.05rem}\n  .cj-ng-hero .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;padding:48px 24px}\n  .cj-ng-hero .hero-media{order:2}\n  .cj-ng-hero .hero-copy{order:1}\n  .cj-ng-hero h1{font-size:clamp(2rem,3.4vw,2.6rem)}\n  .cj-ng-hero .sub{font-size:1.15rem;max-width:38ch}\n  .cj-ng-hero .ratio{font-size:1rem}\n  .cj-ng-hero .feat li{font-size:1.05rem}\n  .cj-ng-hero .hero-cta{flex-direction:row;flex-wrap:wrap;align-items:center}\n  .cj-ng-hero .hero-cta .btn{width:auto}\n  .cj-ng-hero .sizes{text-align:left}\n  .cj-ng-hero .hero-media img{aspect-ratio:1/1}\n  .cj-ng-hero .hero-badge{right:auto;max-width:250px}\n  .cj-ng-trust .wrap{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.85rem;padding:16px 24px}\n  .cj-ng-trust .t:first-child{grid-column:auto;justify-content:flex-start;font-size:.85rem}\n  .cj-ng-sec{padding:64px 0}\n  .cj-ng-probs{grid-template-columns:repeat(4,1fr);gap:18px}\n  .cj-ng-probs .lbl{padding:16px;font-size:1.05rem}\n  .cj-ng-probs .lbl small{font-size:.82rem}\n  .cj-ng-why{padding:64px 0}\n  .cj-ng-why .why-grid{grid-template-columns:repeat(3,1fr);gap:24px}\n  .cj-ng-why .why-card{padding:28px}\n  .cj-ng-why .why-card h3{font-size:1.1rem}\n  .cj-ng-reviews{padding:64px 0}\n  .cj-ng-reviews .rev-grid{grid-template-columns:repeat(3,1fr);gap:22px}\n  .cj-ng-reviews .rev-card{padding:26px}\n  .cj-ng-reviews .rev-card blockquote{font-size:1.02rem}\n}\n</style>\n\n<div class=\"cj-ng cj-ng-hero\">\n  <div class=\"hero-grid\">\n    <div class=\"hero-media\">\n      <img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=1000\" alt=\"Woman wearing CURVJEANS, flat at the waist with no back gap\" loading=\"eager\">\n      <div class=\"hero-badge\">\n        <span class=\"stars\">★★★★★</span>\n        <span class=\"q\">“They fit my hips AND my waist. No belt, no wiggle dance.”</span>\n      </div>\n    </div>\n    <div class=\"hero-copy\">\n      <div class=\"eyebrow\">Small waist, fuller hips</div>\n      <h1>Jeans that finally fit your hips <em>and</em> your waist.</h1>\n      <p class=\"sub\">No back gap. No belt. No sizing up so they pull over your thighs. One pair that just fits, the way you stopped believing was possible.</p>\n      <p class=\"ratio\">Made for a real waist-to-hip difference, so they sit flat at the back even when you sit down.</p>\n      <ul class=\"feat\">\n        <li><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12.5l5 5 11-11\"/></svg> A waistband that hugs your waist and stays put</li>\n        <li><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12.5l5 5 11-11\"/></svg> Soft stretch that moves with you and holds its shape all day</li>\n        <li><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12.5l5 5 11-11\"/></svg> Free size swaps until they fit your body</li>\n      </ul>\n      <div class=\"hero-cta\">\n        <a class=\"btn btn-primary\" href=\"#cj-ng-grid\">Shop the no gap fit</a>\n        <a class=\"btn btn-ghost\" href=\"/pages/fit-quiz\">Take the 30 second fit quiz</a>\n      </div>\n      <p class=\"sizes\">Sizes US 0 to 24. Petite, Regular and Tall lengths.</p>\n    </div>\n  </div>\n</div>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
