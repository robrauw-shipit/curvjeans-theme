    "ng_reviews": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-reviews\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">Real fits, real bodies</div>\n      <h2>From women built like you</h2>\n      <p>The reviews that matter are the ones that tell you their measurements.</p>\n    </div>\n    <div class=\"rev-grid\">\n      <div class=\"rev-card\"><span class=\"stars\">★★★★★</span>\n        <blockquote>“I am a 16 in the hips and a 12 in the waist. These fit over both, and I have not touched a belt since.”</blockquote>\n        <div class=\"who\">Size L, 5'5\", curvy</div></div>\n      <div class=\"rev-card\"><span class=\"stars\">★★★★★</span>\n        <blockquote>“Stretchy but they actually hold their shape. I did not have to change out of them by 5pm for once.”</blockquote>\n        <div class=\"who\">Size 14, full hips and thighs</div></div>\n      <div class=\"rev-card\"><span class=\"stars\">★★★★★</span>\n        <blockquote>“Every other pair gaps at my back. First jeans that sit flat when I sit down. I bought two more.”</blockquote>\n        <div class=\"who\">Size 18, small waist, full seat</div></div>\n    </div>\n    <div class=\"rev-cta\">\n      <a class=\"btn btn-primary\" href=\"#cj-ng-grid\">Shop the no gap fit</a>\n    </div>\n  </div>\n</section>\n",
