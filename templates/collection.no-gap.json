    "ng_probs": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-sec\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">Find your fit fast</div>\n      <h2>Where do regular jeans let you down?</h2>\n      <p>Tell us where they fail you and we will point you to the cut that fixes it.</p>\n    </div>\n    <div class=\"cj-ng-probs\">\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_dd945a50-d4cf-4769-b11a-48db9c6c18f0.jpg?v=1781166162&width=600\" alt=\"Small waist, full hips\"><span class=\"lbl\">Small waist, full hips<small>Closes the back gap</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/MidRise-Black11.jpg?v=1780213356&width=600\" alt=\"Soft belly, no muffin top\"><span class=\"lbl\">Soft belly to smooth<small>Sits high, no muffin top</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Model1-StraightBlack1.jpg?v=1777822432&width=600\" alt=\"Room for hips and thighs\"><span class=\"lbl\">Hips, thighs and seat<small>Room down low, snug up top</small></span></a>\n      <a class=\"prob\" href=\"#cj-ng-grid\"><img src=\"https://curvjeans.com/cdn/shop/files/Brayana-Tall_1.jpg?v=1781166659&width=600\" alt=\"Tall length\"><span class=\"lbl\">Long enough to be Tall<small>Finally hits the floor</small></span></a>\n    </div>\n  </div>\n</section>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "ng_why": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-why\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <div class=\"eyebrow\">Why these are different</div>\n      <h2>The reason there is no gap</h2>\n      <p>Most jeans make you pick: fits the thighs or fits the waist. Here is why you stop having to choose.</p>\n    </div>\n    <div class=\"why-grid\">\n      <div class=\"why-card\">\n        <div class=\"ic\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12h18\"/><path d=\"M7 8c2 2.5 8 2.5 10 0\"/><path d=\"M7 16c2-2.5 8-2.5 10 0\"/></svg></div>\n        <h3>A waistband that actually sits flat</h3>\n        <p>It is built to curve in at the back instead of standing away from it, so you stop sliding your whole hand into a gap and stop pulling your shirt down all day.</p>\n      </div>\n      <div class=\"why-card\">\n        <div class=\"ic\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M2 12h20\"/><path d=\"M6 8l-4 4 4 4\"/><path d=\"M18 8l4 4-4 4\"/></svg></div>\n        <h3>Stretch that stays put</h3>\n        <p>Soft enough that you forget you are wearing jeans, strong enough that it snaps back. No baggy knees by noon, no waistband sliding down when you bend over.</p>\n      </div>\n      <div class=\"why-card\">\n        <div class=\"ic\"><svg class=\"ic-svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 4c0 6 3 10 7 10s7-4 7-10\"/><path d=\"M5 20c0-4 3-6 7-6s7 2 7 6\"/></svg></div>\n        <h3>Cut for your shape, not sized up</h3>\n        <p>Room built into the hips, thighs and seat, so you do not have to buy a bigger size just to get them over your thighs. They slide on without the wiggle dance.</p>\n      </div>\n    </div>\n  </div>\n</section>\n",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "ng_grid_head": {
