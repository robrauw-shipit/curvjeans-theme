        "remove_horizontal_spacing": true,
        "liquid": "\n<section class=\"cj-ng cj-ng-sec\" style=\"padding-bottom:8px\">\n  <a id=\"cj-ng-grid\"></a>\n  <div class=\"wrap\">\n    <div class=\"sec-head\" style=\"margin-bottom:0\">\n      <div class=\"eyebrow\">Shop all</div>\n      <h2>The no gap collection</h2>\n      <p>Soft, stretchy and made to sit flat, in every wash and every leg.</p>\n    </div>\n  </div>\n</section>\n",
