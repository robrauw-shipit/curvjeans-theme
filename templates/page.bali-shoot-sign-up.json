{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"content_width":"80ch"}},"custom_liquid_NiMYWC":{"type":"custom-liquid","name":"Custom Liquid","settings":{"full_width":true,"remove_vertical_spacing":true,"remove_horizontal_spacing":false,"liquid":"<section class=\"curvjeans-custom-header\" id=\"curvjeans-header\">\n  <div class=\"curvjeans-custom-header__inner\">\n    <img \n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/CURVJEANS-06_2.svg?v=1736424968\" \n      alt=\"CURVJEANS\" \n      class=\"curvjeans-custom-header__logo\" \n    \/>\n\n    <a \n      href=\"#apply-form\" \n      class=\"curvjeans-custom-header__cta\"\n    >\n      Sign Up Now\n    <\/a>\n  <\/div>\n<\/section>\n\n<style>\n  :root { --cj-header-h: 56px; } \/* fallback; JS below will update the real height *\/\n\n  .curvjeans-custom-header {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    z-index: 9999;\n    width: 100%;\n    background: #fff;\n    padding: 12px 16px;\n    box-sizing: border-box;\n    box-shadow: 0 1px 3px rgba(0,0,0,.06);\n  }\n  body {\n    padding-top: var(--cj-header-h);\n  }\n\n  .curvjeans-custom-header__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .curvjeans-custom-header__logo {\n    height: 18px;\n    width: auto;\n    display: block;\n  }\n\n  .curvjeans-custom-header__cta {\n    display: inline-block;\n    background-color: #111;\n    color: #fff;\n    font-size: 14px;\n    font-weight: 600;\n    text-decoration: none;\n    padding: 10px 24px;\n    border-radius: 4px;\n    transition: background-color .2s ease;\n  }\n  .curvjeans-custom-header__cta:hover {\n    background-color: #333;\n  }\n\n  @media screen and (max-width: 600px) {\n    .curvjeans-custom-header {\n      padding: 8px 12px;\n    }\n    .curvjeans-custom-header__cta {\n      font-size: 13px;\n      padding: 8px 16px;\n    }\n  }\n\n  \/* Smooth scroll *\/\n  html {\n    scroll-behavior: smooth;\n  }\n<\/style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    const header = document.getElementById('curvjeans-header');\n    const setHeaderSpace = () => {\n      if (!header) return;\n      const h = header.offsetHeight;\n      document.documentElement.style.setProperty('--cj-header-h', h + 'px');\n    };\n    setHeaderSpace();\n    window.addEventListener('resize', setHeaderSpace);\n  });\n<\/script>","background":"","background_gradient":"","text_color":""}},"custom_liquid_La4KzA":{"type":"custom-liquid","name":"Custom Liquid","settings":{"full_width":true,"remove_vertical_spacing":true,"remove_horizontal_spacing":true,"liquid":"<!-- CURVJEANS · Bali Shoot Header with Form -->\n<style>\n  .bali-hero{\n    --radius:16px;\n    --text: #0f0f0f;\n    --muted:#6b6b6b;\n    --bg:#ffffff;\n    --chip:#f3f4f6;\n\n    color:var(--text);\n    background:var(--bg);\n    max-width:1200px;\n    margin:0 auto;\n    padding:clamp(18px,3vw,40px) 16px;\n    display:grid;\n    grid-template-columns: 1fr;\n    gap:24px;\n  }\n  @media (min-width: 980px){\n    .bali-hero{ grid-template-columns: 1fr 1fr; align-items:center; gap:40px; }\n  }\n\n  .bali-hero__media{\n    position:relative;\n    border-radius:var(--radius);\n    overflow:hidden;\n    background:#fafafa;\n  }\n  .bali-hero__media img{\n    width:100%; height:100%; object-fit:cover; display:block;\n  }\n\n  .bali-hero__eyebrow{\n    text-transform:uppercase;\n    letter-spacing:.06em;\n    font-weight:700;\n    font-size:12px;\n    color:var(--muted);\n    margin-bottom:10px;\n  }\n  .bali-hero__title{\n    font-weight:800;\n    line-height:1.1;\n    font-size:clamp(24px, 4.2vw, 44px);\n    margin:0 0 10px 0;\n  }\n  .bali-hero__sub{\n    color:var(--muted);\n    font-size:clamp(14px, 1.6vw, 18px);\n    margin:0 0 16px 0;\n  }\n\n  .bali-hero__chips{\n    display:flex; flex-wrap:wrap; gap:8px; margin:14px 0 18px 0;\n  }\n  .bali-chip{\n    background:var(--chip);\n    border-radius:999px;\n    padding:8px 12px;\n    font-size:14px;\n    display:inline-flex; align-items:center; gap:8px;\n    white-space:nowrap;\n  }\n\n  .bali-form iframe{\n    width:100%!important;\n    max-width:100%;\n    border:none;\n    min-height:1300px; \/* adjust if your form is longer *\/\n  }\n\n  @media (min-width:980px){\n    .bali-hero__media{ order:1; }\n    .bali-hero__copy{ order:2; }\n  }\n<\/style>\n\n<section class=\"bali-hero\">\n  <!-- Media (replace src with lifestyle image URL) -->\n  <figure class=\"bali-hero__media\">\n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0864\/5165\/0895\/files\/Bali_Shoot_1.jpg?v=1757498332\" alt=\"CURVJEANS Bali casting — lifestyle image\" loading=\"lazy\">\n  <\/figure>\n\n  <!-- Copy -->\n  <div class=\"bali-hero__copy\">\n    <div class=\"bali-hero__eyebrow\">Gym Girls & Bali Babes<\/div>\n\n    <h1 class=\"bali-hero__title\">\n      Join our CURVJEANS Bali Photoshoot\n    <\/h1>\n\n    <p class=\"bali-hero__sub\">\n      Get a free pair of CURVJEANS and professional content you can use on your socials.  \n      If things go well, you might even become one of our ambassadors!  \n      <br><br>Fill in the form and provide your Instagram handle so we can check out your profile and reach out to you.  \n      The exact date will be communicated to you if you're selected.\n    <\/p>\n\n    <div class=\"bali-hero__chips\">\n      <span class=\"bali-chip\">📍 Canggu<\/span>\n      <span class=\"bali-chip\">📅 Early October<\/span>\n      <span class=\"bali-chip\">📸 Free professional IG content<\/span>\n      <span class=\"bali-chip\">🤝 Potential collaboration<\/span>\n    <\/div>\n\n    <p class=\"bali-hero__sub\">\n      Fill in your details in the form below and we’ll get back to you asap.\n    <\/p>\n\n    <!-- Google Form Embed -->\n    <div class=\"bali-form\" id=\"apply-form\">\n      <iframe src=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSfod65nHfZjxlVOOztuqJxljmOIorGQxpT5lS9visjT7dXu8Q\/viewform?embedded=true\" width=\"640\" height=\"1737\" frameborder=\"0\" marginheight=\"0\" marginwidth=\"0\">Loading…<\/iframe>\n    <\/div>\n  <\/div>\n<\/section>","background":"","background_gradient":"","text_color":""}}},"order":["main","custom_liquid_NiMYWC","custom_liquid_La4KzA"]}