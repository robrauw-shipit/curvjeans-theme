<style>
  .cj-social-proof {
    width: 100%;
    background: #fff;
    padding: 44px 0 38px;
    color: inherit;
    font: inherit;
    overflow: hidden;
  }

  .cj-social-proof__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .cj-social-proof__header {
    margin-bottom: 22px;
  }

  .cj-social-proof__title {
    margin: 0;
    color: inherit;
    font-family: inherit;
  }

  .cj-social-proof__viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .cj-social-proof__viewport::before,
  .cj-social-proof__viewport::after {
    content: "";
    position: absolute;
    top: 0;
    width: 18px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .cj-social-proof__viewport::before {
    left: 0;
    background: linear-gradient(to right, rgba(255,255,255,.45) 0%, rgba(255,255,255,0) 100%);
  }

  .cj-social-proof__viewport::after {
    right: 0;
    background: linear-gradient(to left, rgba(255,255,255,.45) 0%, rgba(255,255,255,0) 100%);
  }

  .cj-social-proof__track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: cjSocialProofScroll 52s linear infinite;
    will-change: transform;
  }

  @media (hover: hover) and (pointer: fine) {
    .cj-social-proof__viewport:hover .cj-social-proof__track {
      animation-play-state: paused;
    }
  }

  .cj-social-card {
    width: 230px;
    flex: 0 0 230px;
    border-radius: 12px;
    overflow: hidden;
    background: #f4eee8;
    border: none;
  }

  .cj-social-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #f4eee8;
    overflow: hidden;
    border-radius: 12px;
  }

  .cj-social-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .cj-social-card__image-wrap::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 32%;
    background: linear-gradient(to top, rgba(0,0,0,.42) 0%, rgba(0,0,0,0) 100%);
    pointer-events: none;
  }

  .cj-social-card__overlay {
    position: absolute;
    left: 13px;
    right: 13px;
    bottom: 13px;
    z-index: 1;
    color: #fff;
  }

  .cj-social-card__profile {
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
  }

  .cj-social-card__handle {
    font: inherit;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 1px 6px rgba(0,0,0,.28);
  }

  .cj-social-card__verified {
    width: 13px;
    height: 13px;
    flex: 0 0 13px;
    display: block;
  }

  .cj-social-card__meta {
    margin: 4px 0 0;
    font: inherit;
    font-size: 11px;
    line-height: 1.3;
    opacity: .84;
    text-shadow: 0 1px 6px rgba(0,0,0,.28);
  }

  @keyframes cjSocialProofScroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - 8px), 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .cj-social-proof {
      padding: 28px 0 28px;
    }

    .cj-social-proof__inner {
      padding: 0 16px;
    }

    .cj-social-proof__header {
      margin-bottom: 14px;
    }

    .cj-social-proof__viewport::before,
    .cj-social-proof__viewport::after {
      display: none;
    }

    .cj-social-proof__track {
      gap: 10px;
      animation-duration: 44s;
    }

    .cj-social-card {
      width: 48vw;
      max-width: 190px;
      min-width: 165px;
      flex: 0 0 48vw;
      border-radius: 12px;
    }

    .cj-social-card__image-wrap {
      border-radius: 12px;
    }

    .cj-social-card__overlay {
      left: 9px;
      right: 9px;
      bottom: 9px;
    }

    .cj-social-card__handle {
      font-size: 11px;
    }

    .cj-social-card__verified {
      width: 11px;
      height: 11px;
      flex-basis: 11px;
    }

    .cj-social-card__meta {
      margin-top: 3px;
      font-size: 9.5px;
    }

    .cj-social-card__image-wrap::after {
      height: 30%;
      background: linear-gradient(to top, rgba(0,0,0,.38) 0%, rgba(0,0,0,0) 100%);
    }
  }

  @media screen and (max-width: 420px) {
    .cj-social-card {
      width: 50vw;
      flex-basis: 50vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cj-social-proof__track {
      animation: none;
      overflow-x: auto;
      width: 100%;
      padding-bottom: 4px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .cj-social-card {
      scroll-snap-align: start;
    }
  }
</style>