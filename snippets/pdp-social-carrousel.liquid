{% comment %}
  Snippet: pdp-social-carrousel.liquid
  CURVJEANS PDP External Social Proof Carousel
  Recommended placement: directly below main product section, before product recommendations.
{% endcomment %}

{% liquid
  assign cj_locale = 'en'

  if request.path contains '/nl'
    assign cj_locale = 'nl'
  elsif request.path contains '/de'
    assign cj_locale = 'de'
  endif

  case cj_locale
    when 'nl'
      assign cj_social_heading = 'Gedragen door echte vrouwen'
      assign cj_followers_label = 'volgers'
    when 'de'
      assign cj_social_heading = 'Getragen von echten Frauen'
      assign cj_followers_label = 'Follower'
    else
      assign cj_social_heading = 'Worn by real women'
      assign cj_followers_label = 'followers'
  endcase
%}

