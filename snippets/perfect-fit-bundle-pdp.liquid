<div class="cj-bundle-box">

  <!-- HEADER: ICON + TITLE -->
  <div class="cj-bundle-header">
    <img 
      src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/642916-200.png?v=1764585153"
      alt="Gift icon"
      class="cj-bundle-icon"
    >
    <div class="cj-bundle-title">
      {% if request.path contains '/nl' %}
        Perfect Fit Bundel
      {% elsif request.path contains '/de' %}
        Perfect Fit Bundle
      {% else %}
        Perfect Fit Bundle
      {% endif %}
    </div>
  </div>

  <!-- CURRENCY -->
  {% assign c = localization.country.iso_code %}
  {% if c == 'US' or c == 'CA' %}
    {% assign cur_symbol = '$' %}
  {% else %}
    {% assign cur_symbol = '€' %}
  {% endif %}

  {% assign save_two = 15 %}
  {% assign save_three_plus = 35 %}

  <!-- SAVINGS LINES -->
  <div class="cj-bundle-lines">

    {% if request.path contains '/nl' %}
      KOOP 2 — <strong>Bespaar {{ cur_symbol }}{{ save_two }}</strong><br>
      KOOP 3+ — <strong>Bespaar {{ cur_symbol }}{{ save_three_plus }}</strong>
    {% elsif request.path contains '/de' %}
      KAUFE 2 — <strong>Spare {{ cur_symbol }}{{ save_two }}</strong><br>
      KAUFE 3+ — <strong>Spare {{ cur_symbol }}{{ save_three_plus }}</strong>
    {% else %}
      BUY 2 — <strong>Save {{ cur_symbol }}{{ save_two }}</strong><br>
      BUY 3+ — <strong>Save {{ cur_symbol }}{{ save_three_plus }}</strong>
    {% endif %}

    <div class="cj-bundle-subline">
      {% if request.path contains '/nl' %}
        Mix & match — korting automatisch toegepast
      {% elsif request.path contains '/de' %}
        Mix & Match — Rabatt wird automatisch angewendet
      {% else %}
        Mix & Match — Automatic discount
      {% endif %}
    </div>

  </div>

</div>

<style>
  .cj-bundle-box {
    background: #F5F5F5;
    border-radius: 8px;
    padding: 10px 12px; /* smaller padding */
    margin: 10px 0;
  }

  .cj-bundle-header {
    display: flex;
    align-items: center;
    gap: 6px; /* tighter */
    margin-bottom: 4px; /* tighter */
  }

  .cj-bundle-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .cj-bundle-title {
    font-size: 14px; /* slightly smaller */
    font-weight: 700;
    color: #111;
  }

  .cj-bundle-lines {
    font-size: 13.5px;
    color: #111;
    line-height: 1.25; /* tighter line height */
  }

  .cj-bundle-subline {
    margin-top: 3px; /* tighter */
    font-size: 11.5px;
    color: #777;
  }

  @media (max-width: 600px) {
    .cj-bundle-title { font-size: 13.5px; }
    .cj-bundle-lines { font-size: 13px; }
    .cj-bundle-icon { width: 16px; height: 16px; }
  }
</style>
