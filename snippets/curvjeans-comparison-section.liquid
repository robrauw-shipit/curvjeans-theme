      <div class="cj-frow">
        <div class="cj-fcell left">
          <span class="cj-label">
            <span class="cj-lang-en">Natural lift, smooth fit</span>
            <span class="cj-lang-nl">Natuurlijke lift, smoothing fit</span>
            <span class="cj-lang-de">Natürlicher Lift + glättender Effekt</span>
