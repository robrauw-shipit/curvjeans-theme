<style>
  .cj-lang-en,
  .cj-lang-nl,
  .cj-lang-de{
    display:none;
  }

  .cj-compare-wrapper[data-lang="en"] .cj-lang-en,
  .cj-compare-wrapper:not([data-lang]) .cj-lang-en{
    display:inline;
  }

  .cj-compare-wrapper[data-lang="nl"] .cj-lang-nl{
    display:inline;
  }

  .cj-compare-wrapper[data-lang="de"] .cj-lang-de{
    display:inline;
  }

  .cj-compare-wrapper{
    width:100%;
    max-width:1100px;
    margin:40px auto;
    padding:0 16px;
    color:#000;
    font-family:inherit;
  }

  .cj-chart-headline{
    max-width:620px;
    margin:0 auto 24px;
    text-align:center;
    font-size:26px;
    line-height:1.22;
    font-weight:700;
    color:#000;
  }

  .cj-main-container{
    position:relative;
    width:100%;
    overflow:hidden;
    background:#fff;
  }

  .cj-columns{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:0;
    width:100%;
  }

  .cj-col{
    min-width:0;
  }

  .cj-left{
    background:#f7f7f7;
  }

  .cj-right{
    background:#fff;
  }

  .cj-title{
    margin:0;
    padding:13px 8px 11px;
    text-align:center;
    font-size:13px;
    line-height:1.1;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.3px;
    color:#000;
    background:inherit;
  }

  .cj-img-box{
    width:100%;
    aspect-ratio:4 / 5;
    overflow:hidden;
    background:#f5f5f5;
  }

  .cj-img-box img{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center top;
  }

  .cj-feature-grid{
    display:flex;
    flex-direction:column;
    width:100%;
    background:#fff;
    border-top:1px solid #e5e5e5;
  }

  .cj-frow{
    display:grid;
    grid-template-columns:1fr 1fr;
    border-bottom:1px solid #e5e5e5;
  }

  .cj-frow:last-child{
    border-bottom:none;
  }

  .cj-fcell{
    min-width:0;
    padding:14px 14px;
    display:flex;
    align-items:center;
    gap:10px;
    box-sizing:border-box;
  }

  .cj-fcell.left{
    justify-content:space-between;
    background:#f7f7f7;
  }

  .cj-fcell.right{
    justify-content:space-between;
    background:#fff;
  }

  .cj-label{
    font-size:13px;
    line-height:1.28;
    font-weight:600;
    color:#000;
  }

  .cj-label-muted{
    color:#555;
    font-weight:400;
  }

  .cj-top-row .cj-fcell{
    justify-content:center;
    padding:13px 10px;
  }

  .cj-top-text{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:6px;
    text-align:center;
    font-size:13px;
    line-height:1.25;
    font-weight:600;
    color:#000;
  }

  .cj-check-sm,
  .cj-cross-sm{
    width:14px;
    height:14px;
    position:relative;
    flex:0 0 14px;
  }

  .cj-check-sm::after{
    content:"";
    width:7px;
    height:4px;
    border-left:2px solid #16a34a;
    border-bottom:2px solid #16a34a;
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-50%,-60%) rotate(-45deg);
  }

  .cj-cross-sm::before,
  .cj-cross-sm::after{
    content:"";
    position:absolute;
    width:9px;
    height:2px;
    background:#dc2626;
    top:50%;
    left:50%;
    transform-origin:center;
  }

  .cj-cross-sm::before{
    transform:translate(-50%,-50%) rotate(45deg);
  }

  .cj-cross-sm::after{
    transform:translate(-50%,-50%) rotate(-45deg);
  }

  .cj-icon-check,
  .cj-icon-cross{
    width:22px;
    height:22px;
    flex:0 0 22px;
    position:relative;
    border-radius:50%;
  }

  .cj-icon-check{
    background:#000;
  }

  .cj-icon-check::after{
    content:"";
    width:8px;
    height:5px;
    border-left:2px solid #fff;
    border-bottom:2px solid #fff;
    position:absolute;
    left:50%;
    top:50%;
    transform:translate(-55%,-60%) rotate(-45deg);
  }

  .cj-icon-cross{
    border:2px solid #000;
  }

  .cj-icon-cross::before,
  .cj-icon-cross::after{
    content:"";
    position:absolute;
    width:10px;
    height:2px;
    background:#000;
    top:50%;
    left:50%;
    transform-origin:center;
  }

  .cj-icon-cross::before{
    transform:translate(-50%,-50%) rotate(45deg);
  }

  .cj-icon-cross::after{
    transform:translate(-50%,-50%) rotate(-45deg);
  }

  @media (min-width:700px){
    .cj-compare-wrapper{
      margin:60px auto;
      padding:0 40px;
    }

    .cj-chart-headline{
      margin-bottom:32px;
      font-size:32px;
    }

    .cj-main-container{
      overflow:visible;
    }

    .cj-columns{
      padding-bottom:230px;
    }

    .cj-title{
      padding:16px 8px 14px;
      font-size:15px;
    }

    .cj-img-box{
      max-height:500px;
      aspect-ratio:3 / 4;
    }

    .cj-feature-grid{
      position:absolute;
      left:0;
      right:0;
      bottom:0;
      background:rgba(255,255,255,.97);
      border-top:1px solid rgba(0,0,0,.1);
      box-shadow:0 -4px 12px rgba(0,0,0,.08);
    }

    .cj-fcell{
      padding:18px 28px;
      gap:14px;
    }

    .cj-fcell.left{
      background:rgba(247,247,247,.97);
    }

    .cj-fcell.right{
      background:rgba(255,255,255,.97);
    }

    .cj-top-row .cj-fcell{
      padding:18px 28px;
    }

    .cj-label,
    .cj-top-text{
      font-size:15px;
    }

    .cj-icon-check,
    .cj-icon-cross{
      width:26px;
      height:26px;
      flex-basis:26px;
    }
  }

  @media (max-width:699px){
    .cj-compare-wrapper{
      margin:28px auto;
      padding:0;
    }

    .cj-chart-headline{
      padding:0 18px;
      margin-bottom:18px;
      font-size:22px;
    }

    .cj-main-container{
      border-top:1px solid #ededed;
      border-bottom:1px solid #ededed;
    }

    .cj-img-box{
      aspect-ratio:3 / 4;
    }

    .cj-fcell{
      padding:12px 10px;
      gap:8px;
    }

    .cj-label{
      font-size:12.5px;
    }

    .cj-top-text{
      font-size:12.5px;
    }

    .cj-icon-check,
    .cj-icon-cross{
      width:20px;
      height:20px;
      flex-basis:20px;
    }

    .cj-icon-check::after{
      width:7px;
      height:4px;
    }

    .cj-icon-cross::before,
    .cj-icon-cross::after{
      width:9px;
    }
  }
</style>

<script>
  (function(){
    var wrapper = document.querySelector('.cj-compare-wrapper');
    if(!wrapper) return;

    var lang = 'en';
    var urlPath = window.location.pathname.toLowerCase();

    if(urlPath.includes('/nl/') || urlPath.startsWith('/nl')){
      lang = 'nl';
    } else if(urlPath.includes('/de/') || urlPath.startsWith('/de')){
      lang = 'de';
    } else if(wrapper.getAttribute('data-lang')){
      lang = wrapper.getAttribute('data-lang');
    } else if(document.documentElement.lang){
      lang = document.documentElement.lang.toLowerCase().split('-')[0];
    } else if(window.Shopify && window.Shopify.locale){
      lang = window.Shopify.locale.toLowerCase().split('-')[0];
    }

    wrapper.setAttribute('data-lang', ['nl','de','en'].includes(lang) ? lang : 'en');
  })();
</script>