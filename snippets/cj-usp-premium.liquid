{%- comment -%}
CURVJEANS — USP Section (Premium Variant)
Mobile: image first; Desktop: text + image
Includes Luxury Denim + CurveFlex 360° Denim (5× stretchier)
{%- endcomment -%}

{%- assign usp_image = product.metafields.descriptors.usp_image | default: "https://cdn.shopify.com/s/files/1/0864/5165/0895/files/curvjeans_pdp_info.jpg?v=1758861486" -%}

<section id="cj-usp-premium" class="cj-usp-band">
  <div class="cj-usp__wrap">
    <!-- CONTENT -->
    <div class="cj-usp__content">
      <h2 class="cj-usp__title">Made For Your Shape</h2>
      <p class="cj-usp__subtitle">Because your body was never the problem.</p>

      <ul class="cj-usp__grid">
        <li class="cj-usp__item">
          <span class="cj-usp__icon">
            <img src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/waistfit-1.png?v=1752650878" alt="">
          </span>
          <div>
            <div class="cj-usp__heading">Zero Waist Gap</div>
            <p class="cj-usp__desc">WaistFit™ waistband hugs your waist, no belt or pulling needed.</p>
          </div>
        </li>

        <li class="cj-usp__item">
          <span class="cj-usp__icon">
            <img src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/stretchy-3.png?v=1752650879" alt="">
          </span>
          <div>
            <div class="cj-usp__heading">CurveFlex™ 360° Denim</div>
            <p class="cj-usp__desc">5× stretchier than your regular jeans — freedom in every direction.</p>
          </div>
        </li>

        <li class="cj-usp__item">
          <span class="cj-usp__icon">
            <img src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/premium_denim_jeans.png?v=1758268392" alt="">
          </span>
          <div>
            <div class="cj-usp__heading">Luxury Denim Quality</div>
            <p class="cj-usp__desc">Premium fabric, softer feel, holds shape longer.</p>
          </div>
        </li>

        <li class="cj-usp__item">
          <span class="cj-usp__icon">
            <img src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/perfectbutt-5.png?v=1752650877" alt="">
          </span>
          <div>
            <div class="cj-usp__heading">Glute-Lifting Cut</div>
            <p class="cj-usp__desc">Contour seams for a lifted booty, not pushed flat.</p>
          </div>
        </li>

        <li class="cj-usp__item">
          <span class="cj-usp__icon">
            <img src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/flat_tummy_curvjeans.png?v=1758862738" alt="">
          </span>
          <div>
            <div class="cj-usp__heading">Front-Smoothing Fit</div>
            <p class="cj-usp__desc">Smooths the lower tummy for a clean, line-free front.</p>
          </div>
        </li>
      </ul>

      <button type="button" id="cj-usp-premium-cta" class="cj-usp__cta">Shop Perfect Fit</button>
    </div>

    <!-- IMAGE -->
    <div class="cj-usp__media">
      <img src="{{ usp_image }}" alt="CURVJEANS premium fit" loading="lazy">
    </div>
  </div>
</section>

<style>
  .cj-usp-band{ margin:32px 0; }
  .cj-usp__wrap{
    max-width:1200px; margin:0 auto; padding:0 16px;
    display:grid; gap:24px; grid-template-columns:1fr; align-items:center;
  }

  /* Image first on mobile */
  .cj-usp__media{ order:-1; }
  .cj-usp__media img{ width:100%; display:block; border-radius:16px; }

  .cj-usp__content{ text-align:left; }
  .cj-usp__title{ font-size:28px; font-weight:800; margin:0 0 6px; color:#111; }
  .cj-usp__subtitle{ font-size:16px; color:#444; margin:0 0 20px; }

  .cj-usp__grid{
    list-style:none; margin:0 0 16px; padding:0;
    display:grid; gap:16px; grid-template-columns:1fr;
  }
  .cj-usp__item{
    display:flex; gap:12px; align-items:flex-start;
    text-align:left; max-width:560px; margin:0;
  }
  .cj-usp__icon{
    width:44px; height:44px; flex:0 0 44px;
    display:flex; align-items:center; justify-content:center;
    background:#f1f3f5; border-radius:999px;
  }
  .cj-usp__icon img{ width:28px; height:28px; }
  .cj-usp__heading{ font-weight:700; font-size:15px; margin:0 0 4px; color:#111; }
  .cj-usp__desc{ margin:0; font-size:14px; line-height:1.45; color:#333; }

  .cj-usp__cta{
    display:inline-flex; align-items:center; justify-content:center;
    padding:12px 20px; border-radius:999px;
    border:1px solid #111; background:#111; color:#fff;
    font-weight:700; font-size:14px; cursor:pointer;
    margin:20px 0 0; transition:opacity .2s ease;
  }
  .cj-usp__cta:hover{ opacity:.9; }

  @media (min-width:992px){
    .cj-usp__wrap{ grid-template-columns:minmax(0,640px) 1fr; gap:40px; }
    .cj-usp__media{ order:initial; }
    .cj-usp__title{ font-size:40px; }
    .cj-usp__subtitle{ font-size:18px; margin-bottom:28px; }
    .cj-usp__grid{ grid-template-columns:repeat(2, minmax(0,1fr)); gap:20px 24px; }
    .cj-usp__cta{ margin:12px 0 0; }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){
  var path = location.pathname || "";
  var isNL = path.includes('/nl');
  var isDE = path.includes('/de');

  var title    = document.querySelector('#cj-usp-premium .cj-usp__title');
  var subtitle = document.querySelector('#cj-usp-premium .cj-usp__subtitle');
  var items    = document.querySelectorAll('#cj-usp-premium .cj-usp__item');
  var cta      = document.querySelector('#cj-usp-premium-cta');

  if(isNL){
    if(title) title.textContent = "Gemaakt voor jouw shape";
    if(subtitle) subtitle.textContent = "Je lichaam was nooit het probleem.";
    if(items.length >= 5){
      items[0].querySelector('.cj-usp__heading').textContent = "Geen waist gap";
      items[0].querySelector('.cj-usp__desc').textContent    = "WaistFit™ tailleband sluit aan, geen riem of trekken nodig.";
      items[1].querySelector('.cj-usp__heading').textContent = "CurveFlex™ 360° Denim";
      items[1].querySelector('.cj-usp__desc').textContent    = "5× stretchier dan gewone jeans — vrijheid in elke richting.";
      items[2].querySelector('.cj-usp__heading').textContent = "Luxe denimkwaliteit";
      items[2].querySelector('.cj-usp__desc').textContent    = "Premium stof, zachter gevoel, blijft langer in vorm.";
      items[3].querySelector('.cj-usp__heading').textContent = "Glute-lifting cut";
      items[3].querySelector('.cj-usp__desc').textContent    = "Contour-naden liften je booty, niet platgedrukt.";
      items[4].querySelector('.cj-usp__heading').textContent = "Front-smoothing fit";
      items[4].querySelector('.cj-usp__desc').textContent    = "Strijkt de onderbuik glad voor een clean, lijnvrij front.";
    }
    if(cta) cta.textContent = "Shop de perfecte fit";
  }

  if(isDE){
    if(title) title.textContent = "Gemacht für deine Form";
    if(subtitle) subtitle.textContent = "Dein Körper war nie das Problem.";
    if(items.length >= 5){
      items[0].querySelector('.cj-usp__heading').textContent = "Kein Waist Gap";
      items[0].querySelector('.cj-usp__desc').textContent    = "WaistFit™-Bund sitzt perfekt, kein Gürtel oder Zurechtziehen nötig.";
      items[1].querySelector('.cj-usp__heading').textContent = "CurveFlex™ 360° Denim";
      items[1].querySelector('.cj-usp__desc').textContent    = "5× dehnbarer als normale Jeans — Bewegungsfreiheit in alle Richtungen.";
      items[2].querySelector('.cj-usp__heading').textContent = "Luxus-Denimqualität";
      items[2].querySelector('.cj-usp__desc').textContent    = "Premiumstoff, weicheres Gefühl, behält länger die Form.";
      items[3].querySelector('.cj-usp__heading').textContent = "Glute-Lifting Schnitt";
      items[3].querySelector('.cj-usp__desc').textContent    = "Kontur-Nähte heben deinen Po, nicht plattgedrückt.";
      items[4].querySelector('.cj-usp__heading').textContent = "Front-Smoothing Fit";
      items[4].querySelector('.cj-usp__desc').textContent    = "Glättet den Unterbauch für eine saubere, linienfreie Front.";
    }
    if(cta) cta.textContent = "Shop die perfekte Passform";
  }

  if(cta){
    cta.addEventListener('click', function(){
      var form = document.querySelector('form[action*="/cart/add"]') || document.querySelector('[data-product-form]');
      if(form && form.scrollIntoView){
        form.scrollIntoView({ behavior:'smooth', block:'center' });
      }
    });
  }
});
</script>
