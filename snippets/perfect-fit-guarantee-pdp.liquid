{%- liquid
assign _path = request.path | downcase

if _path contains '/nl'
  assign pfg_title = "Perfecte Fit Garantie"
  assign pfg_sub = "De meeste vrouwen hebben na de eerste keer meteen de juiste maat. Zit het toch niet helemaal goed? Dan kun je binnen 14 dagen terugsturen of omruilen."
elsif _path contains '/de'
  assign pfg_title = "Perfekte Passform Garantie"
  assign pfg_sub = "Die meisten Frauen haben beim ersten Mal direkt die richtige Größe. Falls es doch nicht ganz richtig sitzt, kannst du innerhalb von 14 Tagen zurückgeben oder umtauschen."
else
  assign pfg_title = "Perfect Fit Guarantee"
  assign pfg_sub = "Most women get the right fit the first time. If it doesn’t fit your shape perfectly, you can return or exchange within 14 days."
endif
-%}

<div class="cj-pfg-box">

  <!-- FIRST ROW: ICON + HEADLINE -->
  <div class="cj-pfg-row">
<svg class="cj-pdp-guarantee-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none">
  <path d="M11.5151 3.78759L11.3565 3.56536C10.6917 2.63479 9.30873 2.63479 8.64398 3.56536L8.48532 3.78759C8.13433 4.27891 7.5451 4.54201 6.94501 4.47533L6.23749 4.39672C5.17597 4.27877 4.27902 5.17572 4.39697 6.23725L4.47557 6.94476C4.54226 7.54485 4.27916 8.13409 3.78783 8.48507L3.56561 8.64374C2.63503 9.30849 2.63503 10.6915 3.56561 11.3562L3.78783 11.5149C4.27916 11.8659 4.54226 12.4552 4.47557 13.0552L4.39697 13.7627C4.27902 14.8242 5.17597 15.7212 6.23749 15.6032L6.94501 15.5247C7.5451 15.458 8.13433 15.7211 8.48532 16.2124L8.64398 16.4346C9.30873 17.3652 10.6917 17.3652 11.3565 16.4346L11.5151 16.2124C11.8661 15.7211 12.4554 15.458 13.0555 15.5247L13.763 15.6032C14.8245 15.7212 15.7215 14.8242 15.6035 13.7627L15.5249 13.0552C15.4582 12.4552 15.7213 11.8659 16.2126 11.5149L16.4348 11.3562C17.3654 10.6915 17.3654 9.30849 16.4348 8.64374L16.2126 8.48507C15.7213 8.13409 15.4582 7.54485 15.5249 6.94476L15.6035 6.23725C15.7215 5.17572 14.8245 4.27877 13.763 4.39672L13.0555 4.47533C12.4554 4.54201 11.8661 4.27891 11.5151 3.78759Z"
    stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M7.5 10L9.01575 11.5158C9.09908 11.5991 9.23425 11.5991 9.31758 11.5158L12.5 8.33334"
    stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
</svg>

    <div class="cj-pfg-title">{{ pfg_title }}</div>
  </div>

  <!-- SECOND ROW: BODY TEXT -->
  <div class="cj-pfg-body">
    {{ pfg_sub }}
  </div>

</div>

<style>
.cj-pfg-box {
  background: #f9f9f9;
  border: 1px solid #ececec;
  border-radius: 10px;
  padding: 16px;
  margin: 18px 0;
}

/* FIRST ROW: ICON + TITLE */
.cj-pfg-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}

.cj-pfg-icon {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
}

.cj-pfg-title {
  font-size: 18px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0;
}

/* SECOND ROW: BODY FULL WIDTH */
.cj-pfg-body {
  font-size: 14px;
  color: #444;
  line-height: 1.45;
  margin: 0;
  padding-left: 0; /* CRITICAL for full-left alignment */
}

@media (max-width: 480px) {
  .cj-pfg-icon {
    width: 26px;
    height: 26px;
  }
  .cj-pfg-title {
    font-size: 16px;
  }
  .cj-pfg-body {
    font-size: 14px;
  }
}

.cj-pdp-guarantee-icon {
  width: 24px;
  height: 24px;
}

</style>
