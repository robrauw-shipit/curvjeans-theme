{% comment %}
  Size Reassurance + EasySize Placeholder
  Multi-language support: EN, DE, NL
{% endcomment %}

<div class="size-reassurance-wrapper">
  <p class="size-reassurance-text" id="sizeReassurance">
    <img 
      src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/stretchy-3.png?v=1752650879"
      alt=""
      class="size-icon"
    >
    <span class="reassurance-message" id="reassuranceMessage">
      Choose your waist size — the jeans stretch to fit your real curves.
    </span>
  </p>

  <!-- EasySize will inject here -->
  <div class="es_placeholder"></div>
</div>

<script>
(function() {

  // Detect language based on URL
  const path = window.location.pathname;
  let lang = 'en';

  if (path.includes('/de/') || path.startsWith('/de')) {
    lang = 'de';
  } else if (path.includes('/nl/') || path.startsWith('/nl')) {
    lang = 'nl';
  }

  // Translations
  const reassuranceByLang = {
    en: "Choose your waist size — the jeans stretch to fit your real curves.",
    de: "Wähle deine Taillengröße — die Jeans passen sich deinen Kurven an.",
    nl: "Kies je taillemaat — de jeans vormen zich naar je curves."
  };

  function applyReassurance() {
    const el = document.getElementById('reassuranceMessage');
    if (el) el.textContent = reassuranceByLang[lang] || reassuranceByLang.en;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyReassurance);
  } else {
    applyReassurance();
  }

})();
</script>

<style>
  .size-reassurance-wrapper {
    margin-top: 12px;
    margin-bottom: 8px;
    padding: 0;
  }

  .size-reassurance-text {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    line-height: 1.5;
    color: #374151;
    margin: 0 0 8px 0;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .size-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: block;
  }

  .reassurance-message {
    color: #374151;
  }

  /* EasySize button styling */
  .size-reassurance-wrapper #easysize_button {
    background: none;
    border: none;
    padding: 0;
    font-size: 13px;
    color: #6B7280;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color 0.2s ease;
    font-family: inherit;
    text-align: left;
  }

  .size-reassurance-wrapper #easysize_button:hover {
    color: #374151;
  }

  @media (max-width: 768px) {
    .size-reassurance-text {
      font-size: 12px;
      line-height: 1.4;
      margin-bottom: 6px;
    }

    .size-icon {
      width: 28px;
      height: 28px;
    }

    .size-reassurance-wrapper #easysize_button {
      font-size: 12px;
    }
  }
</style>
