{%- assign p = p | default: product -%}
{%- assign v = v | default: p.selected_or_first_available_variant -%}
{%- assign lc = request.locale.iso_code | downcase -%}
{%- assign qty = v.inventory_quantity | default: 0 | plus: 0 -%}

<div class="cj-stock">
  {% if qty > 50 %}
    <span class="cj-dot green pulse"></span>
    <span class="cj-text green-text">
      {%- if lc == 'nl' -%}Op voorraad
      {%- elsif lc == 'de' -%}Auf Lager
      {%- else -%}In stock{%- endif -%}
    </span>
  {% elsif qty > 0 %}
    <span class="cj-dot orange pulse"></span>
    <span class="cj-text orange-text">
      {%- if lc == 'nl' -%}Bijna uitverkocht
      {%- elsif lc == 'de' -%}Fast ausverkauft
      {%- else -%}Almost sold out{%- endif -%}
    </span>
  {% else %}
    <span class="cj-dot red pulse"></span>
    <span class="cj-text red-text">
      {%- if lc == 'nl' -%}Uitverkocht
      {%- elsif lc == 'de' -%}Ausverkauft
      {%- else -%}Sold out{%- endif -%}
    </span>
  {% endif %}
</div>

<style>
  .cj-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 0;
    margin: 6px 0;
    font: inherit;
  }

  .cj-text {
    font: inherit;
    font-size: var(--text-base-size);
  }

  .cj-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 2px;
    flex: 0 0 auto;
  }

  .pulse {
    animation: pulse-cj 2.5s infinite ease-in-out;
  }

  @keyframes pulse-cj {
    0% { transform: scale(.9); opacity: .7; }
    50% { transform: scale(1.1); opacity: 1; }
    100% { transform: scale(.9); opacity: .7; }
  }

  .green {
    background: #00A341;
    box-shadow: 0 0 8px rgba(0, 163, 65, .5);
  }

  .orange {
    background: #FFA500;
    box-shadow: 0 0 8px rgba(255, 165, 0, .5);
  }

  .red {
    background: #D52C2C;
    box-shadow: 0 0 8px rgba(213, 44, 44, .5);
  }

  .green-text { color: #00A341; }
  .orange-text { color: #FFA500; }
  .red-text { color: #D52C2C; }
</style>