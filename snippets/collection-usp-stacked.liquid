{%- comment -%}
CURVJEANS — Hybrid USP Snippet (UPDATED PREMIUM VERSION)
Matches spacing, readability, and calmness of new Review/Social Proof Block
{%- endcomment -%}

{%- liquid
assign _lc = request.locale.iso_code | downcase

case _lc
  when 'nl'
    assign _l1 = 'Geen waist gap'
    assign _l2 = 'Past Taille + Heupen'
    assign _l3 = 'All-day comfort'
    assign _l4 = 'Behoudt vorm'
  when 'de'
    assign _l1 = 'Zero Waist Gap'
    assign _l2 = 'Passt an Taille und Hüfte'
    assign _l3 = 'Ganztags Komfort'
    assign _l4 = 'Formstabil'
  else
    assign _l1 = 'No Waist Gap'
    assign _l2 = 'Fits Waist + Hips'
    assign _l3 = 'All-Day Comfort'
    assign _l4 = 'Holds Its Shape'
endcase
-%}

<style>
/* ============================
   PREMIUM USP BAR
============================ */
.cj-usp-fade {
  border-top: 1px solid #eee;
  border-bottom: 1px solid #eee;
  background: #fff;
  padding: 26px 0; /* MORE breathing room */
  overflow: hidden;
  width: 100%;
}

.cj-usp-fade-wrapper {
  display: flex !important;
  flex-direction: row !important;
  justify-content: center;
  align-items: center;
  gap: 60px; /* more spacing for premium feel */
  opacity: 1;
  transition: opacity .5s ease-in-out;
}

.cj-usp-fade-wrapper.fade-out {
  opacity: 0;
}

/* USP ITEM */
.cj-usp-fade-item {
  display: flex !important;
  flex-direction: row !important;
  justify-content: center;
  align-items: center;
  gap: 10px;   /* nicer spacing */
}

/* ICON */
.cj-usp-fade-icon {
  width: 28px;     /* bigger for readability */
  height: 28px;
}

/* LABEL TEXT */
.cj-usp-fade-label {
  font-size: 14px;        /* more readable */
  font-weight: 500;
  color: #2e2e2e;         /* match social proof & review section */
  letter-spacing: 0.1px;
}

/* DESKTOP - Show all 4 inline */
@media (min-width: 768px){
  .cj-usp-fade-wrapper {
    gap: 60px !important;
  }
}

/* MOBILE */
@media (max-width: 767px){
  .cj-usp-fade {
    padding: 22px 0; /* slightly tighter, still premium */
  }

  .cj-usp-fade-wrapper {
    gap: 36px !important;
    justify-content: center !important;
  }

  .cj-usp-fade-item {
    flex: 0 0 auto !important;
    width: auto !important;
  }

  .cj-usp-fade-icon {
    width: 26px;
    height: 26px;
  }

  .cj-usp-fade-label {
    font-size: 13.5px;
  }
}
</style>


<section class="cj-usp-fade">
  <div class="cj-usp-fade-wrapper" id="cjUspFade">
    <!-- First mobile pair -->
    <div class="cj-usp-fade-item">
      <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/waistfit-1.png?v=1752650878">
      <span class="cj-usp-fade-label">{{ _l1 }}</span>
    </div>
    <div class="cj-usp-fade-item">
      <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/ChatGPT_Image_22_dec_2025_11_08_16_1.png?v=1766387319">
      <span class="cj-usp-fade-label">{{ _l2 }}</span>
    </div>
  </div>
</section>

<script>
(function(){
  const wrapper = document.getElementById('cjUspFade');
  let showingFirst = true;

  function renderDesktop(){
    wrapper.innerHTML = `
      <div class="cj-usp-fade-item">
        <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/waistfit-1.png?v=1752650878">
        <span class="cj-usp-fade-label">{{ _l1 }}</span>
      </div>
      <div class="cj-usp-fade-item">
        <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/ChatGPT_Image_22_dec_2025_11_08_16_1.png?v=1766387319">
        <span class="cj-usp-fade-label">{{ _l2 }}</span>
      </div>
      <div class="cj-usp-fade-item">
        <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/stretchy-3.png?v=1752650879">
        <span class="cj-usp-fade-label">{{ _l3 }}</span>
      </div>
      <div class="cj-usp-fade-item">
        <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/7_55d5b2a8-89e5-43e1-9735-a0ddff5a8f57.jpg?v=1764393986">
        <span class="cj-usp-fade-label">{{ _l4 }}</span>
      </div>
    `;
  }

  function swapMobile(){
    if(window.innerWidth >= 768) return;

    wrapper.classList.add('fade-out');
    setTimeout(() => {
      wrapper.innerHTML = showingFirst
      ? `
        <div class="cj-usp-fade-item">
          <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/stretchy-3.png?v=1752650879">
          <span class="cj-usp-fade-label">{{ _l3 }}</span>
        </div>
        <div class="cj-usp-fade-item">
          <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/7_55d5b2a8-89e5-43e1-9735-a0ddff5a8f57.jpg?v=1764393986">
          <span class="cj-usp-fade-label">{{ _l4 }}</span>
        </div>
      `
      : `
        <div class="cj-usp-fade-item">
          <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/waistfit-1.png?v=1752650878">
          <span class="cj-usp-fade-label">{{ _l1 }}</span>
        </div>
        <div class="cj-usp-fade-item">
          <img class="cj-usp-fade-icon" src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/ChatGPT_Image_22_dec_2025_11_08_16_1.png?v=1766387319">
          <span class="cj-usp-fade-label">{{ _l2 }}</span>
        </div>
      `;
      showingFirst = !showingFirst;
      wrapper.classList.remove('fade-out');
    }, 400);
  }

  if(window.innerWidth >= 768){
    renderDesktop();
  } else {
    setInterval(swapMobile, 5000);
  }

  window.addEventListener('resize', () => {
    if(window.innerWidth >= 768){
      renderDesktop();
    }
  });
})();
</script>
