<style>
  /* =========================
     Layout + Vertical Rhythm
  ========================= */
  .curvjeans-returns-exchanges-preface{
    max-width:1100px;
    margin:80px auto;
    padding:0 20px;
    font-family:inherit;
    color:#111;
  }

  .curvjeans-returns-exchanges-preface__header,
  .curvjeans-returns-exchanges-preface__how,
  .curvjeans-returns-exchanges-preface__klarna,
  .curvjeans-returns-exchanges-preface__cards,
