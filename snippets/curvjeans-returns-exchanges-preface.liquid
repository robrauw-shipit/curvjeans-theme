    align-items:center;
    justify-content:center;
    font-size:12px;
    font-weight:750;
    color:#111;
    margin-top:1px;
  }

  /* =========================
     Klarna notice
  ========================= */
  .curvjeans-returns-exchanges-preface__klarna{
    max-width:880px;
    margin-left:auto;
    margin-right:auto;
    padding:16px 18px;
    border-radius:16px;
    border:1px solid rgba(255,0,128,.18);
    background:rgba(255,0,128,.06);
    display:flex;
    gap:14px;
    align-items:flex-start;
    text-align:left;
