  </div>

  <!-- How it works (clean) -->
  <div class="curvjeans-returns-exchanges-preface__how" aria-label="{{ t_how_title }}">
    <p class="curvjeans-returns-exchanges-preface__how-title">{{ t_how_title }}</p>
    <ul class="curvjeans-returns-exchanges-preface__how-steps">
      <li class="curvjeans-returns-exchanges-preface__how-step">
        <span class="curvjeans-returns-exchanges-preface__how-num">1</span>
        <span>{{ t_how_1 }}</span>
      </li>
      <li class="curvjeans-returns-exchanges-preface__how-step">
        <span class="curvjeans-returns-exchanges-preface__how-num">2</span>
        <span>{{ t_how_2 }}</span>
      </li>
      <li class="curvjeans-returns-exchanges-preface__how-step">
        <span class="curvjeans-returns-exchanges-preface__how-num">3</span>
        <span>{{ t_how_3 }}</span>
      </li>
    </ul>
  </div>

  <!-- Klarna notice (below How it works, above cards) -->
  <div class="curvjeans-returns-exchanges-preface__klarna" role="note" aria-label="Klarna notice">
    <img
      src="{{ cjrx_klarna_logo }}"
      alt="Klarna"
      class="curvjeans-returns-exchanges-preface__klarna-logo"
      loading="lazy"
    />
    <p class="curvjeans-returns-exchanges-preface__klarna-text">
      <strong>{{ t_klarna_title }}</strong>
      {{ t_klarna_body }}
    </p>
  </div>

  <!-- Choice cards -->
  <div class="curvjeans-returns-exchanges-preface__cards" role="group" aria-label="Choose your preferred option">

    <div class="curvjeans-returns-exchanges-preface__card" role="button" tabindex="0" aria-pressed="false" data-curvjeans-rx-choice="exchange">
      <span class="curvjeans-returns-exchanges-preface__badge curvjeans-returns-exchanges-preface__badge--green">{{ t_badge_most }}</span>
      <h3 class="curvjeans-returns-exchanges-preface__card-title">{{ t_ex_title }}</h3>
      <p class="curvjeans-returns-exchanges-preface__card-desc">{{ t_ex_desc }}</p>
      <ul class="curvjeans-returns-exchanges-preface__checklist">
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_ex_b1 }}</span></li>
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_ex_b2 }}</span></li>
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_ex_b3 }}</span></li>
      </ul>
      <p class="curvjeans-returns-exchanges-preface__card-note"><strong>{{ t_ex_note }}</strong></p>
      <div class="curvjeans-returns-exchanges-preface__selected-row" aria-hidden="true">
        <span class="curvjeans-returns-exchanges-preface__selected-label"><span class="curvjeans-returns-exchanges-preface__selected-check">✓</span> {{ t_selected }}</span>
      </div>
    </div>

    <div class="curvjeans-returns-exchanges-preface__card" role="button" tabindex="0" aria-pressed="false" data-curvjeans-rx-choice="credit">
      <span class="curvjeans-returns-exchanges-preface__badge curvjeans-returns-exchanges-preface__badge--mint">{{ t_badge_smart }}</span>
      <h3 class="curvjeans-returns-exchanges-preface__card-title">{{ t_cr_title }}</h3>
      <p class="curvjeans-returns-exchanges-preface__card-desc">{{ t_cr_desc }}</p>
      <ul class="curvjeans-returns-exchanges-preface__checklist">
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_cr_b1 }}</span></li>
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_cr_b2 }}</span></li>
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_cr_b3 }}</span></li>
      </ul>
      <p class="curvjeans-returns-exchanges-preface__card-note">{{ t_cr_note }}</p>
      <div class="curvjeans-returns-exchanges-preface__selected-row" aria-hidden="true">
        <span class="curvjeans-returns-exchanges-preface__selected-label"><span class="curvjeans-returns-exchanges-preface__selected-check">✓</span> {{ t_selected }}</span>
      </div>
    </div>

    <div class="curvjeans-returns-exchanges-preface__card" role="button" tabindex="0" aria-pressed="false" data-curvjeans-rx-choice="refund">
      <span class="curvjeans-returns-exchanges-preface__badge curvjeans-returns-exchanges-preface__badge--grey">{{ t_badge_standard }}</span>
      <h3 class="curvjeans-returns-exchanges-preface__card-title">{{ t_rf_title }}</h3>
      <p class="curvjeans-returns-exchanges-preface__card-desc">{{ t_rf_desc }}</p>
      <ul class="curvjeans-returns-exchanges-preface__checklist">
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_rf_b1 }}</span></li>
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ t_rf_b2 }}</span></li>
        <li class="curvjeans-returns-exchanges-preface__checkitem"><span class="curvjeans-returns-exchanges-preface__checkicon">{{ cjrx_check_svg }}</span><span>{{ rf_shipping_line }}</span></li>
      </ul>
      <p class="curvjeans-returns-exchanges-preface__card-note">{{ t_rf_note }}</p>
      <div class="curvjeans-returns-exchanges-preface__selected-row" aria-hidden="true">
        <span class="curvjeans-returns-exchanges-preface__selected-label"><span class="curvjeans-returns-exchanges-preface__selected-check">✓</span> {{ t_selected }}</span>
      </div>
    </div>

  </div>

  <!-- CTA -->
  <div class="curvjeans-returns-exchanges-preface__cta-wrap">
    <a class="curvjeans-returns-exchanges-preface__cta"
       href="{{ cjrx_portal_url }}"
       target="_blank"
       rel="noopener noreferrer"
       data-curvjeans-rx-cta>
       {{ t_cta_none }}
    </a>
    <p class="curvjeans-returns-exchanges-preface__cta-sub" data-curvjeans-rx-cta-sub>{{ t_cta_sub_none }}</p>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-curvjeans-returns-exchanges-preface]');
    if (!root) return;

    var cards = root.querySelectorAll('[data-curvjeans-rx-choice]');
    var cta = root.querySelector('[data-curvjeans-rx-cta]');
    var ctaSub = root.querySelector('[data-curvjeans-rx-cta-sub]');

    var copyMap = {
      exchange: { cta: {{ t_cta_exchange | json }}, sub: {{ t_cta_sub_exchange | json }} },
      credit:   { cta: {{ t_cta_credit | json }},   sub: {{ t_cta_sub_credit | json }} },
      refund:   { cta: {{ t_cta_refund | json }},   sub: {{ t_cta_sub_refund | json }} },
      none:     { cta: {{ t_cta_none | json }},     sub: {{ t_cta_sub_none | json }} }
    };

    function clearSelection() {
      cards.forEach(function (card) {
        card.classList.remove('is-selected');
        card.setAttribute('aria-pressed', 'false');
        var row = card.querySelector('.curvjeans-returns-exchanges-preface__selected-row');
        if (row) row.style.display = 'none';
      });
    }

    function setSelection(choice) {
      var map = copyMap[choice] || copyMap.none;
      if (cta) cta.textContent = map.cta;
      if (ctaSub) ctaSub.textContent = map.sub;

      if (cta) {
        var base = cta.getAttribute('href') || '';
        try {
          var url = new URL(base, window.location.origin);
          url.searchParams.delete('intent');
          if (choice && choice !== 'none') url.searchParams.set('intent', choice);
          cta.setAttribute('href', url.toString());
        } catch (e) {}
      }
    }

    setSelection('none');

    function onPick(card) {
      var choice = card.getAttribute('data-curvjeans-rx-choice');
      clearSelection();
      card.classList.add('is-selected');
      card.setAttribute('aria-pressed', 'true');

      var row = card.querySelector('.curvjeans-returns-exchanges-preface__selected-row');
      if (row) row.style.display = 'flex';

      setSelection(choice);
    }

    cards.forEach(function (card) {
      card.addEventListener('click', function () { onPick(card); });
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onPick(card); }
      });
    });
  })();
</script>
