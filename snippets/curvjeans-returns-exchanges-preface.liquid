    max-width:880px;
    margin-left:auto;
    margin-right:auto;
  }
  .curvjeans-returns-exchanges-preface__how-title{
    font-size:16px;
    font-weight:750;
    letter-spacing:-.01em;
    margin:0 0 14px;
    color:#111;
  }
  .curvjeans-returns-exchanges-preface__how-steps{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
