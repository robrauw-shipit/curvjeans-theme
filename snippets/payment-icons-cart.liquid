<!-- CURVJEANS — Payment Icons (Cart Drawer) -->
<div class="cart-payment-icons">
  <ul class="cart-payment-icons__list">
    
    <!-- Manual Priority Icons -->
    <li>
      <img src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/klarna.svg?v=1731852955" 
           alt="Klarna" 
           class="cart-payment-icon">
    </li>
    <li>
      <img src="https://cdn.shopify.com/s/files/1/0864/5165/0895/files/ideal.svg?v=1731852955" 
           alt="iDEAL" 
           class="cart-payment-icon">
    </li>

    <!-- Dynamic Shopify Payment Types -->
    {% for type in shop.enabled_payment_types limit: 8 %}
      {% unless type == 'klarna' or type == 'ideal' or type == 'bancontact' %}
        <li>{{ type | payment_type_svg_tag: class: 'cart-payment-icon' }}</li>
      {% endunless %}
    {% endfor %}

  </ul>
</div>

<style>
.cart-payment-icons {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-top: 4px;
}

.cart-payment-icons__list {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.cart-payment-icon {
  width: 38px;
  height: auto;
  display: block;
  opacity: 0.9;
  transition: opacity 0.2s ease;
}

.cart-payment-icon:hover {
  opacity: 1;
}

@media (max-width: 768px) {
  .cart-payment-icons__list {
    gap: 8px;
  }
  .cart-payment-icon {
    width: 30px;
  }
    .cart-payment-icons {
    margin-top: 2px; /* ↓ reduced top margin for mobile */
  }
}
</style>
