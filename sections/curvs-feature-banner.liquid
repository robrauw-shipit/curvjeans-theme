{%- comment -%}
  CURVS Feature Banner — Shapermint-style split product/offer spotlight.
  Image one side, copy + CTA the other. Native + editable.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { --fb-char: {{ section.settings.text_color }}; --fb-bg: {{ section.settings.bg_color }}; }
  #shopify-section-{{ section.id }} .fb { background: var(--fb-bg); }
  #shopify-section-{{ section.id }} .fb__in { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; align-items: center; min-height: 360px; }
  #shopify-section-{{ section.id }} .fb__media { align-self: stretch; min-height: 360px; position: relative; overflow: hidden; }
  #shopify-section-{{ section.id }} .fb__media img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  #shopify-section-{{ section.id }} .fb__media.is-empty { display: grid; place-items: center; background: #EDE7E0; color: #A69E95; }
  #shopify-section-{{ section.id }} .fb__copy { padding: 48px; color: var(--fb-char); {% if section.settings.media_side == 'left' %}order: 2;{% endif %} }
  #shopify-section-{{ section.id }} .fb__eyebrow { font-weight: 800; letter-spacing: .14em; text-transform: uppercase; font-size: .72rem; opacity: .7; }
  #shopify-section-{{ section.id }} .fb__title { font-weight: 800; letter-spacing: -.02em; font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1.03; margin: .35em 0; }
  #shopify-section-{{ section.id }} .fb__text { max-width: 36ch; opacity: .78; margin-bottom: 1.4rem; }
  #shopify-section-{{ section.id }} .fb__btn { display: inline-flex; align-items: center; background: var(--fb-char); color: var(--fb-bg); font-weight: 700; padding: .95rem 2.2rem; border-radius: {{ section.settings.button_radius }}px; text-decoration: none; transition: opacity .15s; }
  #shopify-section-{{ section.id }} .fb__btn:hover { opacity: .88; }
  @media (max-width: 820px) {
    #shopify-section-{{ section.id }} .fb__in { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .fb__copy { padding: 32px 24px; order: 2; }
    #shopify-section-{{ section.id }} .fb__media { order: 1; min-height: 60vw; }
  }
</style>

<div class="fb">
  <div class="fb__in">
    <div class="fb__media {% unless section.settings.image %}is-empty{% endunless %}">
      {%- if section.settings.image -%}
        {{- section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 820px) 100vw, 50vw', widths: '600,800,1000,1200,1400' -}}
      {%- else -%}<span>Add an image</span>{%- endif -%}
    </div>
    <div class="fb__copy">
      {%- if section.settings.eyebrow != blank -%}<div class="fb__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="fb__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="fb__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_text != blank -%}<a class="fb__btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text }}</a>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CURVS Feature Banner",
  "tag": "section",
  "class": "shopify-section--curvs-feature-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "media_side", "label": "Image side", "options": [ {"value":"left","label":"Left"}, {"value":"right","label":"Right"} ], "default": "right" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best seller" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Mid-Rise No-Gap Jean" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sits flat at the back, even when you sit down. The one our customers reorder in every wash." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 6 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#E7C4C7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" }
  ],
  "presets": [ { "name": "CURVS Feature Banner" } ]
}
{% endschema %}
