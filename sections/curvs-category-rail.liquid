{%- comment -%}
  CURVS Category Rail — Shapermint-style horizontal category tiles.
  Native section, image_picker per block, editable. Scrolls on mobile.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} { --cr-char: {{ section.settings.text_color }}; --cr-bone: {{ section.settings.bg_color }}; }
  #shopify-section-{{ section.id }} .cr { background: var(--cr-bone); padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .cr__head { text-align: center; margin-bottom: 18px; padding: 0 16px; }
  #shopify-section-{{ section.id }} .cr__title { font-weight: 800; letter-spacing: -.01em; font-size: 1.35rem; color: var(--cr-char); margin: 0; }
  #shopify-section-{{ section.id }} .cr__sub { color: var(--cr-char); opacity: .6; font-size: .9rem; margin-top: 4px; }
  /* MOBILE-FIRST: flex carousel, fixed-width tiles, reliable scroll */
  #shopify-section-{{ section.id }} .cr__track {
    display: flex; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    scrollbar-width: none; padding: 0 16px 6px; scroll-padding-left: 16px;
  }
  #shopify-section-{{ section.id }} .cr__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .cr__item { flex: 0 0 38%; max-width: 38%; scroll-snap-align: start; text-align: center; text-decoration: none; }
  #shopify-section-{{ section.id }} .cr__thumb { aspect-ratio: {{ section.settings.tile_ratio }}; border-radius: {{ section.settings.tile_radius }}px; overflow: hidden; background: #EDE7E0; }
  #shopify-section-{{ section.id }} .cr__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  #shopify-section-{{ section.id }} .cr__item:hover .cr__thumb img { transform: scale(1.05); }
  #shopify-section-{{ section.id }} .cr__label { font-size: .86rem; font-weight: 700; color: var(--cr-char); margin-top: 8px; letter-spacing: -.01em; }
  #shopify-section-{{ section.id }} .cr__desc { font-size: .74rem; color: var(--cr-char); opacity: .6; margin-top: 2px; line-height: 1.25; }
  #shopify-section-{{ section.id }} .cr__ph { width: 100%; height: 100%; display: grid; place-items: center; color: #A69E95; font-size: .72rem; }
  /* DESKTOP: static row, no scroll */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .cr__head { margin-bottom: 28px; padding: 0 24px; }
    #shopify-section-{{ section.id }} .cr__title { font-size: clamp(1.5rem, 3vw, 2rem); }
    #shopify-section-{{ section.id }} .cr__sub { font-size: .95rem; }
    #shopify-section-{{ section.id }} .cr__track { display: grid; grid-template-columns: repeat({{ section.blocks.size }}, 1fr); gap: 18px; overflow: visible; max-width: 1280px; margin: 0 auto; padding: 0 24px; }
    #shopify-section-{{ section.id }} .cr__item { flex: none; max-width: none; }
    #shopify-section-{{ section.id }} .cr__label { font-size: .9rem; margin-top: 10px; }
    #shopify-section-{{ section.id }} .cr__desc { font-size: .78rem; }
  }
</style>

<div class="cr">
  <div class="cr__head">
    {%- if section.settings.title != blank -%}<h2 class="cr__title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="cr__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
  </div>
  <div class="cr__track">
    {%- for block in section.blocks -%}
      <a class="cr__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="cr__thumb">
          {%- if block.settings.image -%}
            {{- block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '(max-width: 900px) 40vw, 200px', widths: '150,200,300,400,600' -}}
          {%- else -%}
            <span class="cr__ph">Add image</span>
          {%- endif -%}
        </div>
        {%- if block.settings.label != blank -%}<div class="cr__label">{{ block.settings.label }}</div>{%- endif -%}
        {%- if block.settings.desc != blank -%}<div class="cr__desc">{{ block.settings.desc }}</div>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CURVS Category Rail",
  "tag": "section",
  "class": "shopify-section--curvs-category-rail",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Shop by fit" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Find the fit for the part that never fits." },
    { "type": "range", "id": "tile_radius", "label": "Tile radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "select", "id": "tile_ratio", "label": "Tile ratio", "options": [ {"value":"1/1","label":"Square"}, {"value":"3/4","label":"Portrait"}, {"value":"4/5","label":"Tall"} ], "default": "1/1" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1C1C" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "tile", "name": "Category tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Label", "default": "Category" },
      { "type": "text", "id": "desc", "label": "One-liner" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 10,
  "presets": [ { "name": "CURVS Category Rail", "blocks": [ {"type":"tile"}, {"type":"tile"}, {"type":"tile"}, {"type":"tile"}, {"type":"tile"} ] } ]
}
{% endschema %}
